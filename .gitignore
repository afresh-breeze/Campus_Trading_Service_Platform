# 依赖
node_modules/

# 本地配置与密钥
.env
.env.*
!.env.example
*.pem
*.key

# 微信开发者工具私有配置（含个人 AppID 与本机设置）
project.private.config.json

# 演示图片素材（体积大，不入库；打包提交时单独拷贝整个目录）
server/uploads/*
!server/uploads/.gitkeep

# 大文件与录屏
report/*.mp4
*.mp4

# 日志与缓存
*.log
npm-debug.log*
.eslintcache

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.idea/
.vscode/*
!.vscode/extensions.json

# Qoder 本地 AI 技能包（自动生成、体积大，按手册第 12 节各自安装）
.qoder/

# CodeBuddy 本地 AI 技能包（ui-ux-pro-max，同上，不入库）
.codebuddy/

# 临时文件
*.tmp
*.bak
*~
