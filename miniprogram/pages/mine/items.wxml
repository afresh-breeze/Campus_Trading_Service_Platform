<!-- 我的发布（A 成员，11-18）：四状态分类 + item-card 只读列表；状态操作只在详情页 -->
<nav-top back title="我的发布" fixed />

<view class="sv-flex" style="height: calc(100vh - {{stickyTop}}px)">
<scroll-view
  class="page-scroll page-scroll--fill"
  scroll-y
  scroll-top="{{svTop}}"
  refresher-enabled
  refresher-default-style="none"
  refresher-background="transparent"
  refresher-triggered="{{pulling}}"
  bindrefresherrefresh="onRefresh"
  bindscrolltolower="onReachBottom"
>
  <view slot="refresher" class="pull-eyes"
    style="width: 100%; box-sizing: border-box; display: flex; align-items: center; justify-content: center; text-align: center; padding: 20rpx 0;"><loading-eyes mini motto="{{false}}" /></view>
<view class="page page-body mi-page">
  <!-- 吸顶状态条：复用首页分类的横滑椭圆条，滚动时返回键与状态条都常驻 -->
  <view class="mi-cats-wrap" style="top: {{stickyTop}}px">
    <scroll-view class="mi-cats" scroll-x show-scrollbar="{{false}}">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="mi-cat {{status === item.key ? 'mi-cat--active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTabChange"
        hover-class="mi-cat--hover"
      >{{item.label}}</view>
    </scroll-view>
  </view>

  <!-- 首屏骨架 -->
  <block wx:if="{{loading}}">
    <view class="mi-state">
      <loading-eyes />
    </view>
  </block>

  <!-- 首屏失败 / 未登录兜底 -->
  <view wx:elif="{{error}}" class="card mi-state">
    <text class="t-title">{{error === '请先登录' ? '请先登录' : '加载失败'}}</text>
    <text class="t-sub mi-state__desc">{{error === '请先登录' ? '登录后查看你发布的商品' : error}}</text>
    <button class="btn btn-primary btn-block" bindtap="onRetry">{{error === '请先登录' ? '去登录' : '重新加载'}}</button>
  </view>

  <!-- 当前 tab 真空态 -->
  <view wx:elif="{{!items.length}}" class="mi-empty">
    <empty-state
      title="{{emptyTitle}}"
      desc="{{emptyDesc}}"
      action-text="{{emptyActionText}}"
      bind:action="onEmptyAction"
    />
  </view>

  <block wx:else>
    <view class="mi-head">
      <text>共 {{total}} 件</text>
      <text class="mi-head__hint">状态变更请进详情</text>
    </view>

    <view wx:for="{{items}}" wx:key="itemId" class="mi-item">
      <item-card
        item="{{item}}"
        mode="list"
        show-time="{{true}}"
        bind:tap="onTapItem"
      />
    </view>

    <view wx:if="{{loadingMore}}" class="mi-foot"><loading-eyes mini /></view>
    <view wx:elif="{{!hasMore}}" class="mi-foot">没有更多了</view>
  </block>
</view>
</scroll-view>
</view>
