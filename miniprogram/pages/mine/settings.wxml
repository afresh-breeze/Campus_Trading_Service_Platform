<!-- 设置（B 成员，11-17）：通知开关 / 清理缓存 / 版本 / 退出登录 -->
<nav-top back title="设置" fixed />

<view class="page page-body st">
  <view class="card st-group">
    <view class="st-row">
      <view class="st-row__main">
        <text class="st-row__label">消息通知</text>
        <text class="st-row__desc">关闭后消息 tab 不再显示未读红点</text>
      </view>
      <switch checked="{{notifyEnabled}}" color="#79513D" bindchange="onToggleNotify" />
    </view>

    <view class="st-row" bindtap="onClearCache" hover-class="st-row--hover">
      <view class="st-row__main">
        <text class="st-row__label">清理缓存</text>
        <text class="st-row__desc">当前占用 {{cacheSize}}，保留登录状态</text>
      </view>
      <text class="st-row__arrow">›</text>
    </view>
  </view>

  <view class="card st-group">
    <view class="st-row">
      <view class="st-row__main">
        <text class="st-row__label">版本</text>
        <text class="st-row__desc">校园易站 · 课程设计作业</text>
      </view>
      <text class="st-row__value">{{version}}</text>
    </view>
  </view>

  <button wx:if="{{isLogin}}" hover-class="btn--press" class="btn btn-ghost btn-block st-logout" bindtap="onLogout">退出登录</button>
</view>
