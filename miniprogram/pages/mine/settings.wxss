/* 设置（B 成员，11-17） */

.st {
  padding-top: 16rpx;
}

.st-group {
  padding: 0;
  overflow: hidden;
  margin-bottom: var(--space-sm);
}

.st-row {
  transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1);
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 0 var(--space-page);
  border-bottom: 1rpx solid var(--color-divider);
}
.st-row:last-child {
  border-bottom: none;
}
.st-row--hover {
  background-color: var(--color-surface-2);
}
.st-row__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 16rpx 0;
}
.st-row__label {
  font-size: var(--font-base);
  color: var(--color-text);
}
.st-row__desc {
  margin-top: 6rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
}
.st-row__arrow {
  flex: none;
  margin-left: 12rpx;
  font-size: 32rpx;
  color: var(--color-text-4);
}
.st-row__value {
  flex: none;
  margin-left: 12rpx;
  font-size: var(--font-base);
  color: var(--color-text-3);
}

.st-logout {
  margin: var(--space) var(--space) 0;
}
