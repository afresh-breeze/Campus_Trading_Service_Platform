<!-- 我的（B 成员：个人中心，tab 4） -->
<view class="page mine">
  <!-- 用户卡：未登录整卡可点，跳登录 -->
  <view class="mine-hero" bindtap="onTapProfile" hover-class="mine-hero--hover">
    <view class="mine-hero__avatar">
      <image wx:if="{{avatarUrl}}" class="mine-hero__avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <text wx:else class="mine-hero__avatar-text">{{initial}}</text>
    </view>

    <view class="mine-hero__info">
      <view class="mine-hero__row">
        <text class="mine-hero__name">{{nickname}}</text>
        <!-- 组件试渲染点：status-tag 的 user 域（正常 / 已禁用） -->
        <status-tag
          wx:if="{{isLogin}}"
          domain="user"
          status="{{user.status || 'active'}}"
          plain="{{false}}"
        />
      </view>
      <text class="mine-hero__sub">{{subText}}</text>
    </view>

    <text class="mine-hero__arrow">›</text>
  </view>

  <!-- 四项统计：点数字直接进对应列表 -->
  <view class="mine-stats">
    <view
      class="mine-stats__item"
      wx:for="{{stats}}"
      wx:key="key"
      data-url="{{item.url}}"
      bindtap="onTapStat"
      hover-class="mine-stats__item--hover"
    >
      <text class="mine-stats__num">{{item.value}}</text>
      <text class="mine-stats__label">{{item.label}}</text>
    </view>
  </view>

  <!-- 入口分组 -->
  <view class="mine-group" wx:for="{{groups}}" wx:key="key" wx:for-item="group">
    <view class="mine-group__title">{{group.title}}</view>
    <view
      class="mine-cell"
      wx:for="{{group.cells}}"
      wx:key="key"
      data-key="{{item.key}}"
      data-url="{{item.url}}"
      data-auth="{{item.auth}}"
      bindtap="onTapCell"
      hover-class="mine-cell--hover"
    >
      <text class="mine-cell__text">{{item.text}}</text>
      <text class="mine-cell__arrow">›</text>
    </view>
  </view>

  <view wx:if="{{isLogin}}" class="mine-logout" bindtap="onLogout" hover-class="mine-logout--hover">
    退出登录
  </view>

  <view class="mine-footer">校园易站 {{version}}</view>
</view>
