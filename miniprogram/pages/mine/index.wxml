<!-- 我的（B 成员：个人中心，tab 4） -->
<nav-top />
<scroll-view
  class="page-scroll"
  scroll-y
  scroll-top="{{svTop}}"
  refresher-enabled
  refresher-default-style="none"
  refresher-background="transparent"
  refresher-triggered="{{pulling}}"
  bindrefresherrefresh="onRefresh"
  bindscrolltolower="onReachBottom"
>
  <view slot="refresher" class="pull-eyes"
    style="width: 100%; box-sizing: border-box; display: flex; align-items: center; justify-content: center; text-align: center; padding: 20rpx 0;"><loading-eyes mini motto="{{false}}" /></view>
<view class="page page--tab mine">
  <!-- 用户卡：未登录整卡可点，跳登录 -->
  <view class="mine-hero" bindtap="onTapProfile" hover-class="mine-hero--hover">
    <view class="mine-hero__avatar">
      <image wx:if="{{avatarUrl}}" class="mine-hero__avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <text wx:else class="mine-hero__avatar-text">{{initial}}</text>
    </view>

    <view class="mine-hero__info">
      <view class="mine-hero__row">
        <text class="mine-hero__name">{{nickname}}</text>
        <!-- 组件试渲染点：status-tag 的 user 域（正常 / 已禁用） -->
        <status-tag
          wx:if="{{isLogin}}"
          domain="user"
          status="{{user.status || 'active'}}"
          plain="{{false}}"
        />
      </view>
      <text class="mine-hero__sub">{{subText}}</text>
    </view>

    <text class="mine-hero__arrow">›</text>
  </view>

  <!-- 二手市场 / 代取 两块插画卡：行级入口 + 数量（上卡在右、下卡在左，接单设置留白） -->
  <view class="mkt-card mkt-card--{{card.key}}" wx:for="{{marketCards}}" wx:key="key" wx:for-item="card">
    <view class="mkt-card__inner">
      <view class="mkt-card__title">{{card.title}}</view>
      <view
        class="mkt-card__row"
        wx:for="{{card.rows}}"
        wx:key="key"
        wx:for-item="row"
        data-url="{{row.url}}"
        data-auth="{{row.auth}}"
        bindtap="onTapCell"
        hover-class="mkt-card__row--hover"
      >
        <!-- 两套 DOM：shop 名称左/数量右；errand 数字左 + 虚线引导 + 名称右
             （不依赖 margin-left:auto——真机 flex text 上不生效，11-29 教训） -->
        <block wx:if="{{card.key === 'shop'}}">
          <text class="mkt-card__name">{{row.text}}</text>
          <text class="mkt-card__num">{{row.value}}</text>
        </block>
        <block wx:else>
          <text class="mkt-card__num">{{row.value}}</text>
          <view class="mkt-card__leader"></view>
          <text class="mkt-card__name">{{row.text}}</text>
        </block>
      </view>
    </view>
    <view class="mkt-card__art">
      <image class="mkt-card__img mkt-card__img--{{card.key}}" src="{{card.art}}" mode="heightFix" />
    </view>
  </view>

  <!-- 入口分组 -->
  <view class="mine-group" wx:for="{{groups}}" wx:key="key" wx:for-item="group">
    <view class="mine-group__title">{{group.title}}</view>
    <view
      class="mine-cell"
      wx:for="{{group.cells}}"
      wx:key="key"
      data-key="{{item.key}}"
      data-url="{{item.url}}"
      data-auth="{{item.auth}}"
      bindtap="onTapCell"
      hover-class="mine-cell--hover"
    >
      <text class="mine-cell__text">{{item.text}}</text>
      <text class="mine-cell__arrow">›</text>
    </view>
  </view>

  <view wx:if="{{isLogin}}" class="mine-logout" bindtap="onLogout" hover-class="mine-logout--hover">
    退出登录
  </view>

  <view class="mine-footer">校园易站 {{version}}</view>
</view>
</scroll-view>
