/* 我的发布（A 成员，11-18）：只引用 app.wxss 的设计令牌 */

.mi-page {
  /* 非 tab 页不避让 tabBar，覆盖 .page 的 150rpx 留白 */
  padding-bottom: calc(var(--space) + env(safe-area-inset-bottom));
}

/* ---------------- 吸顶状态条 ---------------- */
.mi-cats-wrap {
  position: -webkit-sticky;
  position: sticky;
  z-index: 20;
  padding: 8rpx 0 16rpx;
  background-color: var(--color-bg);
}
.mi-cats {
  width: 100%;
  height: 60rpx;
  white-space: nowrap;
}
.mi-cats::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}
.mi-cat {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 26rpx;
  margin-right: var(--space-sm);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-full);
  background-color: var(--color-bg-white);
  font-size: 26rpx;
  color: var(--color-text-2);
  vertical-align: top;
}
.mi-cat--active {
  border-color: transparent;
  background-color: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-weight: 600;
}
.mi-cat--hover {
  opacity: 0.85;
}

/* ---------------- 列表 ---------------- */
.mi-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 4rpx 12rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
}
.mi-head__hint {
  color: var(--color-text-4);
}
.mi-item {
  margin-bottom: 16rpx;
}
.mi-foot {
  padding: 12rpx 0 24rpx;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-4);
}

/* ---------------- 状态 ---------------- */
.mi-state {
  padding: 48rpx var(--space);
  text-align: center;
}
.mi-state__desc {
  display: block;
  margin: 12rpx 0 28rpx;
}
.mi-empty {
  padding: 40rpx 0;
}

/* ---------------- 首屏骨架 ---------------- */
.mi-sk {
  display: flex;
  padding: 20rpx;
}
.mi-sk__cover {
  flex: none;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: var(--color-divider);
}
.mi-sk__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  padding-top: 8rpx;
}
.mi-sk__line {
  height: 24rpx;
  margin-bottom: 18rpx;
  border-radius: 8rpx;
  background-color: var(--color-divider);
}
.mi-sk__line--lg {
  width: 80%;
  height: 32rpx;
}
.mi-sk__line--md {
  width: 60%;
}
.mi-sk__line--sm {
  width: 40%;
}