/* 我的代取（B 成员，11-15） */

/* ---- 角色切换 tab ---- */
.me-tabs {
  display: flex;
  position: relative;
  background: var(--color-surface, #ffffff);
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}
/* 滑动指示条：绝对定位的棕色胶囊，切 tab 时 transform 平移（回弹曲线），不生切 */
.me-tabs__pill {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  width: calc(50% - 6rpx);
  border-radius: 12rpx;
  background: var(--color-primary-dark);
  transition: transform 250ms cubic-bezier(0.22, 1, 0.36, 1);
}
.me-tabs__pill--right {
  transform: translateX(100%);
}
.me-tabs__item {
  transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), opacity 120ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 200ms ease-out;
  flex: 1;
  position: relative;
  text-align: center;
  padding: 16rpx 0;
  font-size: var(--font-md, 28rpx);
  color: var(--color-text-2, #6b5b4d);
  border-radius: 12rpx;
}
.me-tabs__item--active {
  color: #ffffff;
  font-weight: 600;
}
.me-tabs__item--hover {
  opacity: 0.7;
}

/* ---- 状态筛选 chips ---- */
.me-chips {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.me-chip {
  transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), opacity 120ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 200ms ease-out;
  display: inline-flex;
  align-items: center;
  padding: 10rpx 26rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: var(--color-surface, #ffffff);
  font-size: var(--font-sm, 26rpx);
  color: var(--color-text-2, #6b5b4d);
}
.me-chip--active {
  background: var(--color-primary-dark);
  color: #ffffff;
}
.me-chip--hover {
  opacity: 0.9;
}
.me-chip__count {
  margin-left: 8rpx;
  font-size: var(--font-xs, 22rpx);
  opacity: 0.75;
}

/* ---- 分组 ---- */
.me-section {
  margin-bottom: 28rpx;
}
.me-section__head {
  display: flex;
  align-items: baseline;
  margin: 8rpx 4rpx 16rpx;
}
.me-section__title {
  font-size: var(--font-md, 28rpx);
  font-weight: 600;
  color: var(--color-text-1, #3b2f26);
}
.me-section__count {
  margin-left: 12rpx;
  font-size: var(--font-xs, 22rpx);
  color: var(--color-text-3, #9a8c7d);
}

/* ---- 订单卡 ---- */
.me-order {
  transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), opacity 120ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 200ms ease-out;
  margin-bottom: 20rpx;
}
.me-order--hover {
  /* 全站口径：只压暗不缩放（11-25 方案二） */
  opacity: 0.94;
  box-shadow: var(--shadow-card-hover);
}
.me-order__top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.me-order__route {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}
.me-order__line {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.me-order__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.me-order__dot--from {
  background: var(--color-primary-dark);
}
.me-order__dot--to {
  background: var(--color-success, #4a8c5c);
}
.me-order__place {
  font-size: var(--font-md, 28rpx);
  color: var(--color-text-1, #3b2f26);
}
.me-order__reward {
  text-align: right;
  flex-shrink: 0;
}
.me-order__price {
  display: block;
  font-size: var(--font-lg, 32rpx);
  font-weight: 700;
  color: var(--color-price);
}
.me-order__reward-label {
  font-size: var(--font-xs, 22rpx);
  color: var(--color-text-3, #9a8c7d);
}
.me-order__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin: 12rpx 0 0;
}
.me-order__tag {
  margin-left: 12rpx;
}
.me-order__desc {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-sm, 26rpx);
  color: var(--color-text-2, #6b5b4d);
}
.me-order__completed {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-sm, 26rpx);
  color: var(--color-success, #4a8c5c);
}
.me-order__foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}
.me-order__who {
  font-size: var(--font-xs, 22rpx);
  color: var(--color-text-3, #9a8c7d);
  min-width: 0;
}
.me-order__go {
  flex-shrink: 0;
  font-size: var(--font-xs, 22rpx);
  color: var(--color-text-3, #9a8c7d);
}

/* ---- 快捷操作 ---- */
.me-order__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border, #eee6d8);
}
.me-act {
  margin: 0 0 0 16rpx;
  font-size: var(--font-sm, 26rpx);
  line-height: 2.2;
  background: var(--color-surface-2, #f4f1e7);
  color: var(--color-text-2, #6b5b4d);
}
.me-act--hover {
  /* 全站口径：按压只压暗（11-25 方案二补齐） */
  opacity: 0.9;
}
.me-act--primary {
  background: var(--color-primary-dark);
  color: #ffffff;
}
.me-act--danger {
  background: transparent;
  color: var(--color-danger, #c0563e);
  border: 1rpx solid var(--color-danger, #c0563e);
}

/* ---- 状态区（空/错） ---- */
.me-state {
  padding: 40rpx 0;
}

/* 首屏加载：眼睛无白卡直接居中（11-25，同 rp-state--loading 方案） */
.me-state--loading {
  text-align: center;
  padding: 160rpx 0 40rpx;
}
.me-state__card {
  text-align: center;
}
.me-state__desc {
  display: block;
  margin: 12rpx 0 24rpx;
}

/* ---- 超量提示 ---- */
.me-more {
  text-align: center;
  padding: 16rpx 0 8rpx;
}
.me-more__text {
  font-size: var(--font-xs, 22rpx);
  color: var(--color-text-4, #b3a695);
}
