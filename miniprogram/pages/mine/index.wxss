/* 我的（B 成员：个人中心，tab 4）——只引用 app.wxss 变量，不写魔法色值 */
.mine {
  /* 注意：padding 简写会覆盖 .page 的 padding-bottom，这里必须显式补回悬浮 tabBar 的避让高度 */
  padding: 24rpx 24rpx calc(150rpx + env(safe-area-inset-bottom));
}

/* ---------- 用户卡 ---------- */
.mine-hero {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  /* UI 优化 6.6：暖色渐变用户卡 + 右上柔光圆 */
  background: linear-gradient(135deg, #FCE7C8 0%, #FFFFFF 70%);
  border-radius: 28rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
  position: relative;
  transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), opacity 120ms cubic-bezier(0.22, 1, 0.36, 1);
}
.mine-hero::before {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -50rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(230, 168, 116, 0.22), transparent 70%);
  pointer-events: none;
}

.mine-hero--hover {
  transform: scale(0.985);
  opacity: 0.94;
}

.mine-hero__avatar {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 50%;
  /* 4rpx 页面底色描边，头像更「立」（方案 6.6） */
  border: 4rpx solid var(--color-bg);
  box-sizing: content-box;
  margin-left: 4rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 浅焦糖 → 主色，头像占位也有层次 */
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary) 100%);
}

.mine-hero__avatar-img {
  width: 100%;
  height: 100%;
}

.mine-hero__avatar-text {
  font-size: 44rpx;
  font-weight: 600;
  /* 深棕压在浅焦糖上，对比度 4.1:1；不用白字（红线） */
  color: #6A4431;
}

.mine-hero__info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.mine-hero__row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mine-hero__name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mine-hero__sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}

.mine-hero__arrow {
  font-size: 38rpx;
  line-height: 1;
  color: var(--color-text-4);
}

/* ---------- 四项统计 ---------- */
/* ---------- 二手市场 / 代取 合并插画卡（11-25 v4，先预览后落地） ---------- */
.mkt-card {
  margin-top: 20rpx;
  background-color: var(--color-bg-white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.mkt-card__divider {
  border-top: 1rpx dashed var(--color-divider);
  margin: 0 28rpx;
}
.mkt-sec {
  display: flex;
  align-items: stretch;
}
.mkt-sec__inner {
  flex: 1;
  min-width: 0;
  padding: 28rpx 28rpx 16rpx;
}
.mkt-sec__title {
  font-size: 54rpx;
  line-height: 1.25;
  font-weight: 700;
  color: var(--color-text);
}
.mkt-sec--errand .mkt-sec__title {
  text-align: right;
}
/* 行：名称左 / 数量右 / 箭头最右；按压背景平滑变化（压暗不缩放，A 侧口径防字抖） */
.mkt-card__row {
  display: flex;
  align-items: center;
  margin: 0 -12rpx;
  padding: 26rpx 20rpx 24rpx;
  border-radius: 20rpx;
  border-bottom: 1rpx dashed var(--color-divider);
  transition: background-color 150ms ease;
}
.mkt-card__row:last-child {
  border-bottom: none;
}
.mkt-card__row--press {
  background-color: var(--color-surface-2);
}
.mkt-card__name {
  flex: 1;
  font-size: var(--font-md);
  color: var(--color-text);
  white-space: nowrap;
}
/* 数量是次级信息：深棕加粗、固定宽右对齐（接单设置留白占位） */
.mkt-card__num {
  flex: none;
  width: 60rpx;
  text-align: right;
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-primary-dark);
  font-variant-numeric: tabular-nums;
}
.mkt-card__arrow {
  flex: none;
  margin-left: 16rpx;
  font-size: 34rpx;
  line-height: 1;
  color: var(--color-text-4);
}
.mkt-sec__art {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 16rpx 20rpx 0;
}
.mkt-sec--errand .mkt-sec__art {
  order: 1;
  padding: 20rpx 0 20rpx 16rpx;
}
.mkt-sec--errand .mkt-sec__inner {
  order: 2;
}
.mkt-card__img--shop {
  height: 236rpx;
  width: 236rpx;
  opacity: 0.55;
}
.mkt-card__img--errand {
  height: 300rpx;
  width: 300rpx;
  opacity: 0.55;
}

/* ---------- 入口分组 ---------- */
.mine-group {
  margin-top: 20rpx;
  background-color: var(--color-bg-white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.mine-group__title {
  padding: 22rpx 28rpx 10rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
  letter-spacing: 2rpx;
}

.mine-cell {
  display: flex;
  align-items: center;
  height: 100rpx;
  padding: 0 28rpx;
  position: relative;
  transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1);
}

.mine-cell::after {
  content: '';
  position: absolute;
  left: 28rpx;
  right: 0;
  bottom: 0;
  height: 1px;
  background-color: var(--color-divider);
}

.mine-cell:last-child::after {
  display: none;
}

.mine-cell--hover {
  background-color: var(--color-surface-2);
}

.mine-cell__text {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text);
}

.mine-cell__arrow {
  font-size: 34rpx;
  line-height: 1;
  color: var(--color-text-4);
}

/* ---------- 退出登录 / 版本 ---------- */
.mine-logout {
  margin-top: 20rpx;
  height: 96rpx;
  transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--color-danger);
  background-color: var(--color-bg-white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.mine-logout--hover {
  background-color: var(--color-divider);
}

.mine-footer {
  padding: 32rpx 0 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-4);
}
