/* 接单设置 / 上线接单（B 成员）｜只引用 app.wxss 的令牌与原子类 */
.form-tip {
  margin: 8rpx 0 16rpx;
}

/* ---------------- 顶部状态条 ---------------- */
.status-bar {
  display: flex;
  align-items: center;
  padding: 20rpx var(--space-lg);
  border-radius: var(--radius);
  margin-bottom: var(--space-sm);
  font-size: var(--font-base);
}
.status-bar--on {
  background-color: rgba(31, 122, 69, 0.1);
  color: var(--color-success);
}
.status-bar--off {
  background-color: var(--color-bg-white);
  color: var(--color-text-3);
  box-shadow: var(--shadow-card);
}
.status-bar__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}
.status-bar--on .status-bar__dot {
  background-color: var(--color-success);
}
.status-bar--off .status-bar__dot {
  background-color: var(--color-text-4);
}
.status-bar__text {
  flex: 1;
}
.status-bar__count {
  font-size: var(--font-xs);
}

/* ---------------- 勾选网格 ---------------- */
.zone-group {
  margin-bottom: 20rpx;
}
.zone-group__title {
  font-size: var(--font-xs);
  color: var(--color-text-3);
  margin-bottom: 10rpx;
}
.check-grid {
  display: flex;
  flex-wrap: wrap;
}
.check-item {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
  margin-bottom: 12rpx;
  font-size: var(--font-base);
  color: var(--color-text);
}
.check-item checkbox,
.check-item radio {
  transform: scale(0.8);
  margin-right: 2rpx;
}
.check-item--wide {
  margin-right: 48rpx;
}
.check-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.check-row--wrap {
  flex-wrap: wrap;
  margin-top: 12rpx;
}
.radio-row--gap {
  row-gap: 12rpx;
}

/* ---------------- 计划列表 ---------------- */
.slot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.slot-row:last-child {
  border-bottom: none;
}
.slot-row__main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.slot-row__text {
  font-size: var(--font-base);
  color: var(--color-text);
  margin-right: 14rpx;
}
.slot-row__ops {
  display: flex;
  align-items: center;
}
.slot-op {
  font-size: var(--font-sm);
  color: var(--color-primary-dark);
  padding: 6rpx 18rpx;
}
.slot-op--danger {
  color: var(--color-danger);
}

/* ---------------- 计划表单 ---------------- */
.slot-form {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.slot-form__times {
  display: flex;
  align-items: center;
}
.slot-form__dash {
  margin: 0 14rpx;
  color: var(--color-text-3);
}
.slot-ops {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* ---------------- picker 与底部 ---------------- */
.picker-value {
  display: inline-block;
  min-width: 190rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
  background-color: var(--color-bg);
  font-size: var(--font-base);
  color: var(--color-text);
  text-align: center;
}
.form-actions {
  margin-top: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.form-actions .btn-ghost {
  border: 1rpx solid var(--color-danger);
  color: var(--color-danger);
  background-color: var(--color-bg-white);
}
