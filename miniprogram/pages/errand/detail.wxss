/**
 * 代取详情（B 成员，11-12）
 * 只允许引用 app.wxss 的变量，不写魔法色值。
 * 底部固定操作栏会遮挡内容，所以 .detail 预留 190rpx + 安全区。
 */

.detail {
  min-height: 100vh;
  padding: var(--space-page);
  padding-bottom: calc(var(--space) + env(safe-area-inset-bottom));
  background-color: var(--color-bg);
}

/* 有底部操作栏时才让出高度 */
.detail--bar {
  padding-bottom: calc(230rpx + env(safe-area-inset-bottom));
}

/* ---------------- 加载 / 错误 ---------------- */
.detail-state {
  padding: 100rpx 0;
  text-align: center;
}
.detail-state__card {
  display: flex;
  flex-direction: column;
  text-align: left;
}
.detail-state__desc {
  margin-top: 12rpx;
}
.detail-state__btn {
  margin-top: 32rpx;
}

/* ---------------- 头部：状态 + 报酬 ---------------- */
.detail-head {
  display: flex;
  flex-direction: column;
}
.detail-head__tags {
  display: flex;
  flex-wrap: wrap;
}
.detail-head__tag {
  margin: 0 12rpx 12rpx 0;
}
.detail-head__reward {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}
.detail-head__price {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-price);
  font-variant-numeric: tabular-nums;
}
.detail-head__label {
  margin-left: 12rpx;
  font-size: var(--font-sm);
  color: var(--color-text-3);
}
.detail-head__time {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--color-text-2);
}

/* ---------------- 路线：登机牌式横向布局（11-25 用户预览确认） ----------------
   取件左 / 送达右，中段跑步小人 + dotted 半圆粒子弧；备注在虚线下。
   配色不新增：弧用 text-4（border 族），端点用 accent / primary-dark 与两侧圆点呼应 */
.detail-route {
  padding-bottom: 8rpx;
}
.detail-route__top {
  display: flex;
  align-items: flex-start;
}
.detail-route__col {
  flex: 1;
  min-width: 0;
}
.detail-route__col--to {
  text-align: right;
}
.detail-route__line {
  display: flex;
  align-items: center;
}
.detail-route__col--to .detail-route__line {
  justify-content: flex-end;
}
.detail-route__label {
  font-size: var(--font-sm);
  color: var(--color-text-3);
}
/* 地点值不截断：详情页出现「南区教学区 · …」显示不全是大忌（11-25 用户反馈） */
.detail-route__value {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.3;
  word-break: break-all;
}
/* 地标下方的片区小字（取件列专用，同名/无地标时不渲染） */
.detail-route__value-sub {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-sm);
  color: var(--color-text-3);
}
/* 起终点圆点：起=深棕（稳），终=辅色（暖），不靠颜色传达信息，标注文字同时存在 */
.detail-route__dot {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
.detail-route__dot--from {
  margin-right: 16rpx;
  background-color: var(--color-primary-dark);
}
.detail-route__dot--to {
  margin-left: 16rpx;
  background-color: var(--color-accent);
}
/* 中段：整圈粒子环 + 跑步小人（runner.png 为本地生成的 #79513D 圆头笔画剪影）。
   11-25 用户反馈：整体缩小并垂直居中——顶部不超过「取件」行、底部不低于片区小字行，
   用 flex 拉伸 + 居中自适应左右列高度，不再写死偏移 */
.detail-route__mid {
  flex: none;
  width: 176rpx;
  align-self: stretch;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 粒子环：84×84rpx，dots 位置由 js 按 % 预生成 */
.detail-route__ring {
  position: relative;
  flex: none;
  width: 84rpx;
  height: 84rpx;
}
.detail-route__ring-dot {
  position: absolute;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
/* 四档色全部取自既有令牌：0 顶部最深 → 3 底部最浅 */
.detail-route__ring-dot--0 {
  background-color: var(--color-primary-dark);
}
.detail-route__ring-dot--1 {
  background-color: var(--color-accent);
}
.detail-route__ring-dot--2 {
  background-color: var(--color-text-4);
}
.detail-route__ring-dot--3 {
  background-color: var(--color-border);
}
.detail-route__runner {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  margin-left: -22rpx;
  margin-top: -22rpx;
}
/* 虚线下的备注行：小灰标签 + 内容，长备注换行不占地点区 */
.detail-route__foot {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
  padding: 20rpx 0 8rpx;
  border-top: 3rpx dashed var(--color-border);
}
.detail-route__remark-label {
  flex: none;
  margin-right: 20rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
}
.detail-route__remark {
  flex: 1;
  min-width: 0;
  font-size: var(--font-sm);
  line-height: 1.5;
  color: var(--color-text-2);
}

/* ---------------- 信息列表（11-25 层级优化） ----------------
   主：规格（胶囊 32rpx/700 浅主色底）+ 描述（32rpx/700 近黑整块左对齐）
   辅：编号/时间（24rpx 灰阶），分割线隔开两组，行距收紧
   口径与大厅卡片一致：字号差 + 明度差同时拉，层级靠值承载，label 不竞争 */
.detail-info__label {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-3);
  line-height: 1.4;
}
.detail-info__spec {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.detail-info__size-chip {
  flex: none;
  padding: 8rpx 28rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-primary-light);
  font-size: var(--font-lg);
  font-weight: 700;
  line-height: 1.3;
  color: var(--color-primary-dark);
}
.detail-info__desc-block {
  margin-top: 32rpx;
}
.detail-info__desc {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-lg);
  font-weight: 700;
  line-height: 1.55;
  color: var(--color-text);
  word-break: break-all;
}
.detail-info__desc--empty {
  font-weight: 400;
  color: var(--color-text-3);
}
.detail-info__meta {
  margin-top: 26rpx;
  padding-top: 6rpx;
  border-top: 1rpx solid var(--color-divider);
}
.detail-info__row {
  transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), opacity 120ms cubic-bezier(0.22, 1, 0.36, 1);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.detail-info__row--meta {
  padding: 12rpx 0;
}
.detail-info__row--hover {
  opacity: 0.7;
}
.detail-info__k {
  flex: none;
  font-size: var(--font-sm);
  color: var(--color-text-3);
}
.detail-info__v {
  flex: 1;
  text-align: right;
  font-size: var(--font-sm);
  color: var(--color-text-2);
  word-break: break-all;
}
.detail-info__copy {
  margin-left: 12rpx;
  font-size: var(--font-xs);
  color: var(--color-primary-dark);
}

/* ---------------- 发布人 / 接单人 ---------------- */
.detail-people__row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.detail-people__avatar {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: var(--color-divider);
}
.detail-people__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lg);
  color: var(--color-primary-dark);
  background-color: var(--color-primary-light);
}
.detail-people__info {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}
.detail-people__name {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text);
}
.detail-people__sub {
  margin-top: 2rpx;
  font-size: var(--font-sm);
  color: var(--color-text-3);
}
.detail-people__role {
  font-size: var(--font-xs);
  color: var(--color-text-3);
}
.detail-people__chat {
  height: 68rpx;
  margin-top: 16rpx;
  font-size: var(--font-sm);
}
.detail-people__tip {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
  text-align: center;
}

/* ---------------- 无可用操作时的说明 ---------------- */
.detail-backhall {
  transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), opacity 120ms cubic-bezier(0.22, 1, 0.36, 1);
  margin: var(--space) var(--space) 0;
  padding: 22rpx 0;
  text-align: center;
  border-radius: var(--radius);
  background-color: var(--color-bg-white);
  box-shadow: var(--shadow-card);
}
.detail-backhall--hover {
  background-color: var(--color-bg);
}
.detail-backhall__text {
  font-size: var(--font-sm);
  color: var(--color-accent);
}

.detail-hint {
  margin-top: 24rpx;
  font-size: var(--font-sm);
  color: var(--color-text-3);
  text-align: center;
}

/* ---------------- 底部固定操作栏 ---------------- */
.detail-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  padding: 16rpx var(--space) calc(16rpx + env(safe-area-inset-bottom));
  background-color: var(--color-bg-white);
  border-top: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-bar);
}
/* 聊天说明小字（原卡片里的 tip），在按钮行上方 */
.detail-bar__tip {
  margin-bottom: 10rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
  text-align: center;
}
.detail-bar__row {
  display: flex;
}
.detail-bar__btn {
  flex: 1;
  min-width: 0;
}
.detail-bar__btn + .detail-bar__btn {
  margin-left: 16rpx;
}
