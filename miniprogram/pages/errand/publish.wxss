/* 发布代取 / 编辑代取（B 成员）｜只引用 app.wxss 的令牌与原子类 */
.form-tip {
  margin: 8rpx 0 16rpx;
}

.field--top {
  height: auto;
  min-height: 96rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  align-items: flex-start;
}
.field--top .field-label {
  padding-top: 6rpx;
}

.field--static .field-input,
.field-input--muted {
  color: var(--color-text-3);
}
.field-input--error {
  color: var(--color-danger);
}

.field-textarea {
  flex: 1;
  min-height: 120rpx;
  font-size: var(--font-base);
  color: var(--color-text);
  width: 100%;
}

.field-count {
  text-align: right;
  padding: 0 var(--space) 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-4);
}

/* 物品图片（紧跟物品描述） */
.image-field__body {
  flex: 1;
  min-width: 0;
}
.field-error--block {
  padding-left: 0;
  padding-right: 0;
}
.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-inner);
  overflow: hidden;
  background-color: var(--color-bg);
}
.img-item__img {
  display: block;
  width: 100%;
  height: 100%;
}
.img-item__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xs);
  color: var(--color-text-2);
  background-color: rgba(255, 255, 255, 0.82);
}
.img-item__mask--fail {
  color: var(--color-danger);
  background-color: rgba(255, 255, 255, 0.9);
}
.img-item__del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: rgba(46, 33, 25, 0.55);
  color: var(--color-bg-white);
  font-size: 26rpx;
  line-height: 1;
}
.img-item__del--hover,
.img-item--hover {
  opacity: 0.8;
}
.img-item--add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--color-border);
  background-color: var(--color-bg-white);
}
.img-item__plus {
  font-size: 40rpx;
  line-height: 1;
  color: var(--color-text-3);
}
.img-item__add-text {
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
}
.image-tip {
  margin-top: 12rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
}

/* 单选横排 */
.radio-row {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
}
.radio-item {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
  font-size: var(--font-base);
  color: var(--color-text);
}
.radio-item radio {
  transform: scale(0.8);
  margin-right: 4rpx;
}

/* picker 触发值 */
.picker-value {
  min-width: 190rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
  background-color: var(--color-bg);
  font-size: var(--font-base);
  color: var(--color-text);
  text-align: center;
}
.picker-value--time {
  margin-left: 12rpx;
}
.picker-arrow {
  color: var(--color-text-4);
  font-size: var(--font-xl);
  line-height: 1;
}

/* 底部操作区 */
.form-actions {
  margin-top: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.form-actions .btn-ghost {
  border: none;
  background-color: var(--color-primary-light);
  color: var(--color-primary-dark);
}
.form-footnote {
  text-align: center;
  line-height: 1.6;
  padding: 0 var(--space);
}

/* 地点选择入口行按压反馈（wxml 已引用，此前无定义） */
.field--hover {
  background-color: var(--color-surface-2);
}
