/* 搜索结果（A 成员，11-16）：只引用 app.wxss 的设计令牌，不写死主题色 */

/* 非 tab 页不避让 tabBar，覆盖 .page 的 150rpx 留白 */
.search-page {
  padding-bottom: calc(var(--space) + env(safe-area-inset-bottom));
}

/* ---------------- 顶部整块吸附 ---------------- */
.search-bar {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 0 var(--space-page) 12rpx;
  background-color: var(--color-bg);
}
.search-bar__safe {
  overflow: hidden;
}
.search-bar__head {
  display: flex;
  align-items: center;
}
.search-back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: var(--color-bg-white);
  box-shadow: var(--shadow-card);
}
.search-back--hover {
  opacity: 0.8;
}
.search-back__chevron {
  width: 16rpx;
  height: 16rpx;
  border-left: 4rpx solid var(--color-text);
  border-bottom: 4rpx solid var(--color-text);
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.search-bar__row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-bg-white);
  box-shadow: var(--shadow-card);
}
.search-input__icon {
  position: relative;
  flex: none;
  width: 26rpx;
  height: 26rpx;
  margin-right: 14rpx;
  border: 3rpx solid var(--color-text-3);
  border-radius: 50%;
}
.search-input__icon::after {
  content: '';
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background-color: var(--color-text-3);
  transform: rotate(45deg);
  transform-origin: left center;
}
.search-input__field {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  font-size: 26rpx;
  color: var(--color-text);
}
.search-input__ph {
  font-size: 26rpx;
  color: var(--color-text-3);
}
.search-input__clear {
  flex: none;
  width: 44rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
  color: var(--color-text-3);
}
.search-submit {
  flex: none;
  height: 80rpx;
  margin-left: 16rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background-color: var(--color-primary-dark);
  color: var(--color-bg-white);
  font-size: 26rpx;
  font-weight: 600;
}
.search-submit--hover {
  opacity: 0.88;
}

/* ---------------- 输入联想 ---------------- */
.search-suggest {
  position: absolute;
  left: var(--space-page);
  right: var(--space-page);
  top: 100%;
  z-index: 20;
  margin-top: 4rpx;
  padding: 8rpx 0;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background-color: var(--color-bg-white);
  box-shadow: var(--shadow-card-hover);
  overflow: hidden;
}
.search-suggest__row {
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx;
}
.search-suggest__row--hover {
  background-color: var(--color-divider);
}
.search-suggest__row--action {
  border-bottom: 1rpx solid var(--color-divider);
  margin-bottom: 4rpx;
}
.search-suggest__icon {
  position: relative;
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-right: 14rpx;
  border: 3rpx solid var(--color-text-3);
  border-radius: 50%;
}
.search-suggest__icon::after {
  content: '';
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background-color: var(--color-text-3);
  transform: rotate(45deg);
  transform-origin: left center;
}
.search-suggest__action {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--color-text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.search-suggest__loading {
  padding: 10rpx 20rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
}
.search-suggest__cover {
  flex: none;
  width: 56rpx;
  height: 72rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: var(--color-divider);
}
.search-suggest__img {
  width: 100%;
  height: 100%;
}
.search-suggest__cover-empty {
  width: 100%;
  height: 100%;
  background-color: var(--color-divider);
}
.search-suggest__body {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}
.search-suggest__title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.search-suggest__meta {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.search-suggest__count {
  flex: none;
  margin-left: 12rpx;
  font-size: var(--font-xs);
  color: var(--color-accent);
}

/* ---------------- 初始态：历史 / 提示 ---------------- */
.search-history {
  padding: var(--space-page) var(--space-page) 0;
}
.search-history__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.search-history__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}
.search-history__clear {
  padding: 8rpx 0 8rpx 24rpx;
  font-size: var(--font-sm);
  color: var(--color-text-3);
}
.search-history__clear--hover {
  opacity: 0.7;
}
.search-history__list {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--space-sm);
}
.search-history__chip {
  max-width: 100%;
  margin: 0 var(--space-sm) var(--space-sm) 0;
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-full);
  background-color: var(--color-bg-white);
  font-size: 26rpx;
  color: var(--color-text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.search-history__chip--hover {
  background-color: var(--color-primary-light);
}

.search-tips {
  padding: 80rpx var(--space-page) 0;
}
.search-tips__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}
.search-tips__desc {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-sm);
  color: var(--color-text-3);
}
.search-tips__chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--space);
}
.search-tips__chip {
  margin: 0 var(--space-sm) var(--space-sm) 0;
  padding: 12rpx 28rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-full);
  background-color: var(--color-bg-white);
  font-size: 26rpx;
  color: var(--color-primary-dark);
  box-shadow: var(--shadow-card);
}
.search-tips__chip--hover {
  background-color: var(--color-primary-light);
}

/* ---------------- 相关图书 ---------------- */
.search-books {
  padding: var(--space-page) var(--space-page) 0;
}
.search-books__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.search-books__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}
.search-books__count {
  font-size: var(--font-xs);
  color: var(--color-text-3);
}
.search-filter {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  margin-top: var(--space-sm);
  padding: 8rpx 18rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-size: var(--font-sm);
}
.search-filter--hover {
  opacity: 0.85;
}
.search-filter__text {
  max-width: 560rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.search-filter__x {
  margin-left: 8rpx;
  font-size: 30rpx;
  line-height: 1;
}

.search-books__list {
  margin-top: var(--space-sm);
}
.book-card {
  display: flex;
  padding: 20rpx;
  border: 2rpx solid transparent;
  border-radius: var(--radius-card);
  background-color: var(--color-bg-white);
  box-shadow: var(--shadow-card);
  transition:
    transform 120ms var(--ease-out),
    opacity 120ms var(--ease-out),
    box-shadow 200ms ease-out;
}
.book-card + .book-card {
  margin-top: var(--space-sm);
}
.book-card--active {
  border-color: var(--color-primary-dark);
}
.book-card--hover {
  /* 全站口径：只压暗不缩放（11-25 方案二） */
  opacity: 0.94;
  box-shadow: var(--shadow-card-hover);
}
.book-card__cover {
  flex: none;
  width: 132rpx;
  height: 176rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: var(--color-divider);
}
.book-card__img {
  width: 100%;
  height: 100%;
}
.book-card__cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xs);
  color: var(--color-text-4);
}
.book-card__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.book-card__title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  color: var(--color-text);
}
.book-card__line {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--color-text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.book-card__isbn {
  margin-top: 6rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.book-card__foot {
  margin-top: auto;
  padding-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.book-card__count {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-accent);
}
.search-books__toggle {
  margin-top: var(--space-sm);
  padding: 16rpx 0;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-primary-dark);
}
.search-books__toggle--hover {
  opacity: 0.7;
}

/* ---------------- 计数 + 排序 ---------------- */
.search-sort {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56rpx;
  margin: 12rpx var(--space-page) 0;
}
.search-sort__count {
  flex: 1;
  min-width: 0;
  font-size: var(--font-xs);
  color: var(--color-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.search-sort__ops {
  display: flex;
  flex: none;
  align-items: center;
}
.search-sort__item {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  color: var(--color-text-2);
}
.search-sort__item--hover {
  opacity: 0.7;
}
.search-sort__item--active {
  color: var(--color-primary-dark);
  font-weight: 700;
}
.search-sort__divider {
  width: 1rpx;
  height: 24rpx;
  margin: 0 14rpx;
  background-color: var(--color-border);
}
.search-sort__item--price {
  min-width: 96rpx;
  justify-content: flex-end;
}
.search-sort__arrow {
  width: 20rpx;
  margin-left: 2rpx;
  font-size: 22rpx;
  text-align: center;
}

/* ---------------- 状态区（错误） ---------------- */
.search-state {
  padding: var(--space-page);
}
.search-state__card {
  text-align: center;
}

/* 首屏加载：眼睛无白卡直接居中（11-25，去掉 sk-card 底框） */
.search-state--loading {
  text-align: center;
  padding: 160rpx var(--space-page) 40rpx;
}
.search-state__desc {
  display: block;
  margin: var(--space-sm) 0 var(--space);
  line-height: 1.6;
  word-break: break-all;
}
.search-state__card .btn {
  margin-top: var(--space);
}

/* ---------------- 首屏骨架 ---------------- */
.search-sk {
  display: flex;
  margin: 20rpx var(--space-page) 0;
  padding: 20rpx;
  border-radius: var(--radius-card);
  background-color: var(--color-bg-white);
  box-shadow: var(--shadow-card);
}
.search-sk__cover {
  flex: none;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-inner);
}
.search-sk__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  padding-top: 6rpx;
}
.search-sk__line {
  height: 24rpx;
  border-radius: var(--radius-sm);
}
.search-sk__line + .search-sk__line {
  margin-top: 18rpx;
}
.search-sk__line--lg {
  width: 62%;
  height: 30rpx;
}
.search-sk__line--md {
  width: 44%;
}
.search-sk__line--sm {
  width: 30%;
}
/* ---------------- 商品列表 ---------------- */
.search-items {
  padding: 0 var(--space-page);
}
.search-items__item {
  margin-top: 20rpx;
}
.search-items__item:first-child {
  margin-top: 24rpx;
}

/* ---------------- 底部加载提示 ---------------- */
.search-more {
  padding: var(--space) 0 var(--space-sm);
  text-align: center;
}
.search-more__text {
  font-size: var(--font-xs);
  color: var(--color-text-4);
}
