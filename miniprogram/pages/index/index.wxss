/* 二手首页（A 成员，11-14）：只引用 app.wxss 的设计令牌，不写死主题色 */

/* ---------------- 顶部整块吸附 ---------------- */
.home-bar {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 0 var(--space-page) 10rpx;
  background-color: var(--color-bg);
}
.home-bar__safe {
  overflow: hidden;
}
.home-bar__head {
  display: flex;
  align-items: center;
}
.home-bar__title {
  font-size: 44rpx;
  color: var(--color-text);
  letter-spacing: 2rpx;
  line-height: 1;
}
.home-bar__subrow {
  display: block;
}
.home-bar__sub {
  display: block;
  margin: 6rpx 0;
  font-size: var(--font-sm);
  line-height: 1.5;
  color: var(--color-text-3);
}

/* 搜索胶囊：只是入口，不是 input */
.home-search {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin-top: 10rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-bg-white);
  box-shadow: var(--shadow-card);
}
.home-search--hover {
  opacity: 0.9;
}
.home-search__icon {
  position: relative;
  flex: none;
  width: 26rpx;
  height: 26rpx;
  margin-right: 14rpx;
  border: 3rpx solid var(--color-text-3);
  border-radius: 50%;
}
.home-search__icon::after {
  content: '';
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background-color: var(--color-text-3);
  transform: rotate(45deg);
  transform-origin: left center;
}
.home-search__ph {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--color-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------------- 分类横滑 ---------------- */
.home-cats {
  width: 100%;
  height: 60rpx;
  margin-top: 16rpx;
  white-space: nowrap;
}
.home-cats::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}
.home-cat {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 26rpx;
  margin-right: var(--space-sm);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-full);
  background-color: var(--color-bg-white);
  font-size: 26rpx;
  color: var(--color-text-2);
  vertical-align: top;
}
.home-cat--hover {
  background-color: var(--color-surface-2);
}
.home-cat--active {
  border-color: transparent;
  background-color: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-weight: 700;
}

/* ---------------- 计数 + 排序 ---------------- */
.home-sort {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56rpx;
  margin-top: 12rpx;
}
.home-sort__count {
  flex: 1;
  min-width: 0;
  font-size: var(--font-xs);
  color: var(--color-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.home-sort__ops {
  display: flex;
  flex: none;
  align-items: center;
}
.home-sort__item {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  color: var(--color-text-2);
}
.home-sort__item--hover {
  opacity: 0.7;
}
.home-sort__item--active {
  color: var(--color-primary-dark);
  font-weight: 700;
}
.home-sort__divider {
  width: 1rpx;
  height: 24rpx;
  margin: 0 14rpx;
  background-color: var(--color-border);
}
.home-sort__item--price {
  min-width: 96rpx;
  justify-content: flex-end;
}
.home-sort__arrow {
  width: 20rpx;
  margin-left: 2rpx;
  font-size: 22rpx;
  text-align: center;
}

/* ---------------- 状态区（登录 / 错误） ---------------- */
.home-state {
  padding: var(--space-page);
}
.home-state__card {
  text-align: center;
}

/* 首屏加载：眼睛无白卡直接居中（11-25，同 search-state--loading 方案） */
.home-state--loading {
  text-align: center;
  padding: 160rpx var(--space-page) 40rpx;
}
.home-state__desc {
  display: block;
  margin: var(--space-sm) 0 var(--space);
  line-height: 1.6;
  word-break: break-all;
}
.home-state__card .btn {
  margin-top: var(--space);
}

/* ---------------- 首屏骨架 ---------------- */
.home-sk {
  display: flex;
  margin: 20rpx var(--space-page) 0;
  padding: 20rpx;
  background-color: var(--color-bg-white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}
.home-sk__cover {
  flex: none;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-inner);
}
.home-sk__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  padding-top: 6rpx;
}
.home-sk__line {
  height: 24rpx;
  border-radius: var(--radius-sm);
}
.home-sk__line + .home-sk__line {
  margin-top: 18rpx;
}
.home-sk__line--lg {
  width: 62%;
  height: 30rpx;
}
.home-sk__line--md {
  width: 44%;
}
.home-sk__line--sm {
  width: 30%;
}
/* ---------------- 商品列表 ---------------- */
.home-list {
  padding: 0 var(--space-page);
}
.home-list__item {
  margin-top: 20rpx;
}
.home-list__item:first-child {
  margin-top: 24rpx;
}

/* ---------------- 底部加载提示 ---------------- */
.home-more {
  padding: var(--space) 0 var(--space-sm);
  text-align: center;
}
.home-more__text {
  font-size: var(--font-xs);
  color: var(--color-text-4);
}

.fab--hover {
  opacity: 0.88;
}
