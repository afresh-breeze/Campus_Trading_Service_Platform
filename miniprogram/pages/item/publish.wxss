/* 发布商品（A 成员，11-16）：只引用 app.wxss 的设计令牌，不写死主题色 */

.publish-page {
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

/* ---------------- 模式切换 ---------------- */
.mode-switch {
  display: flex;
  padding: 8rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-bg-white);
  box-shadow: var(--shadow-card);
  margin-bottom: var(--space-sm);
}
.mode-switch__item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  font-size: var(--font-base);
  color: var(--color-text-2);
  transition:
    background-color 200ms var(--ease-out),
    color 200ms var(--ease-out),
    transform 120ms var(--ease-out),
    opacity 120ms var(--ease-out);
}
.mode-switch__item--on {
  background-color: var(--color-primary-dark);
  color: var(--color-bg-white);
  font-weight: 600;
}

.form-tip {
  margin: 8rpx 0 16rpx;
}
.req {
  margin-left: 4rpx;
  color: var(--color-danger);
}

/* ---------------- 表单行 ---------------- */
.field--top {
  height: auto;
  min-height: 96rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  align-items: flex-start;
}
.field--top .field-label {
  padding-top: 6rpx;
}
.field-textarea {
  flex: 1;
  width: 100%;
  min-height: 120rpx;
  font-size: var(--font-base);
  color: var(--color-text);
}
.field-count {
  padding: 0 var(--space) 8rpx;
  text-align: right;
  font-size: var(--font-xs);
  color: var(--color-text-4);
}
.field-input--muted {
  color: var(--color-text-3);
}
.field-input--picker {
  display: flex;
  align-items: center;
}
.field-input--switch {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.field-unit {
  flex: none;
  margin-left: 8rpx;
  font-size: var(--font-sm);
  color: var(--color-text-3);
}
.field-picker {
  display: block;
}
.picker-arrow {
  flex: none;
  font-size: var(--font-xl);
  line-height: 1;
  color: var(--color-text-4);
}
.field-error--block {
  padding-left: 0;
  padding-right: 0;
}

/* ---------------- 图片 ---------------- */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}
.img-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-inner);
  overflow: hidden;
  background-color: var(--color-bg);
}
.img-item__img {
  width: 100%;
  height: 100%;
}
.img-item__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xs);
  color: var(--color-text-2);
  background-color: rgba(255, 255, 255, 0.82);
}
.img-item__mask--fail {
  color: var(--color-danger);
  background-color: rgba(255, 255, 255, 0.9);
}
.img-item__del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: rgba(46, 33, 25, 0.55);
  color: var(--color-bg-white);
  font-size: 28rpx;
  line-height: 1;
}
.img-item--add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--color-border);
  background-color: var(--color-bg-white);
}
.img-item__plus {
  font-size: 44rpx;
  line-height: 1;
  color: var(--color-text-3);
}
.img-item__add-text {
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
}

/* ---------------- 书目联想 ---------------- */
.book-suggest {
  margin-top: 4rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.book-suggest__loading,
.book-suggest__empty {
  padding: 16rpx 20rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
}
.book-suggest__row {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.book-suggest__row:last-child {
  border-bottom: none;
}
.book-suggest__row--hover {
  background-color: var(--color-divider);
  transform: scale(0.985);
}
.book-suggest__body {
  flex: 1;
  min-width: 0;
}
.book-suggest__title {
  font-size: var(--font-base);
  font-weight: 500;
  color: var(--color-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.book-suggest__meta {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.book-suggest__count {
  flex: none;
  margin-left: 12rpx;
  font-size: var(--font-xs);
  color: var(--color-accent);
}

/* ---------------- 已选书目 ---------------- */
.book-selected {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg);
}
.book-selected__body {
  flex: 1;
  min-width: 0;
}
.book-selected__title {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text);
}
.book-selected__meta {
  margin-top: 6rpx;
  font-size: var(--font-xs);
  color: var(--color-text-2);
}
.book-selected__isbn {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
}
.book-selected__actions {
  flex: none;
  display: flex;
  align-items: center;
  margin-left: 12rpx;
}
.book-selected__action {
  padding: 8rpx 0 8rpx 20rpx;
  font-size: var(--font-sm);
  color: var(--color-primary-dark);
}
.book-selected__action--muted {
  color: var(--color-text-3);
}

/* ---------------- 手动新建书目 ---------------- */
.book-manual-link {
  padding: 20rpx 0 4rpx;
  font-size: var(--font-sm);
  color: var(--color-primary-dark);
}
.manual-book {
  margin-top: 8rpx;
}
.book-manual-cancel {
  padding: 20rpx 0 4rpx;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-text-3);
}

/* ---------------- 地点快捷 ---------------- */
.place-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 16rpx;
}
.place-chip {
  padding: 10rpx 22rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-full);
  background-color: var(--color-bg-white);
  font-size: var(--font-xs);
  color: var(--color-text-2);
}
.place-chip--on {
  border-color: var(--color-primary-dark);
  background-color: var(--color-primary-light);
  color: var(--color-primary-dark);
}
.place-tip {
  margin-top: 12rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
}

/* ---------------- 底部固定发布栏 ---------------- */
.publish-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding: 16rpx var(--space-page) calc(16rpx + env(safe-area-inset-bottom));
  background-color: var(--color-bg-white);
  border-top: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-bar);
}
.publish-bar__tip {
  margin-bottom: 10rpx;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-4);
}