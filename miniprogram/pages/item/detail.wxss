/* 商品详情（A 成员，11-16）：只引用 app.wxss 的设计令牌，不写魔法主题色 */

.detail {
  min-height: 100vh;
  padding: var(--space-page);
  padding-bottom: calc(var(--space-page) + env(safe-area-inset-bottom));
  background-color: var(--color-bg);
}

/* 有底部操作栏时才让出高度 */
.detail--bar {
  padding-bottom: calc(230rpx + env(safe-area-inset-bottom));
}

/* ---------------- 骨架屏 ---------------- */
.detail-sk__gallery {
  height: 520rpx;
  border-radius: var(--radius-inner);
}
.detail-sk__line {
  height: 24rpx;
  margin-top: 18rpx;
  border-radius: var(--radius-sm);
}
.detail-sk__line--lg {
  width: 62%;
  height: 32rpx;
}
.detail-sk__line--md {
  width: 44%;
}
.detail-sk__line--sm {
  width: 30%;
}
/* ---------------- 加载失败 / 404 ---------------- */
.detail-state {
  padding: 100rpx 0;
  text-align: center;
}
.detail-state__card {
  display: flex;
  flex-direction: column;
  text-align: left;
}
.detail-state__desc {
  margin-top: 12rpx;
  line-height: 1.6;
}
.detail-state__btn {
  margin-top: 32rpx;
}

/* ---------------- 轮播 ---------------- */
.card.gallery {
  position: relative;
  padding: 0;
  border-radius: var(--radius-card);
  overflow: hidden;
}
.gallery__swiper {
  width: 100%;
  height: 520rpx;
}
.gallery__img {
  display: block;
  width: 100%;
  height: 100%;
}
.gallery__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 26rpx;
  color: var(--color-text-4);
  background-color: var(--color-divider);
}
.gallery__empty--full {
  height: 520rpx;
}
.gallery__count {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  background-color: rgba(46, 33, 25, 0.55);
  color: var(--color-bg-white);
  font-size: 20rpx;
  line-height: 1.5;
}

/* ---------------- 价格 / 标题 ---------------- */
.detail-head__tags {
  display: flex;
  flex-wrap: wrap;
}
.detail-head__tag {
  margin: 0 12rpx 12rpx 0;
}
.detail-head__price {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}
.detail-head__yuan {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-price);
}
.detail-head__num {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--color-price);
}
.detail-head__origin {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-4);
  text-decoration: line-through;
}
.detail-head__title {
  display: block;
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--color-text);
}
.detail-head__meta {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}
.detail-head__meta .tag {
  margin: 0 12rpx 8rpx 0;
  font-size: 22rpx;
}

/* ---------------- 商品信息 ---------------- */
.detail-info__title,
.detail-desc__title,
.detail-seller__title {
  font-size: 32rpx;
  font-weight: 700;
}
.detail-info__title {
  margin-bottom: 8rpx;
}
.detail-info__row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 10rpx 0;
}
.detail-info__k {
  flex: none;
  width: 160rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}
.detail-info__v {
  flex: 1;
  font-size: 26rpx;
  text-align: right;
  color: var(--color-text-2);
  word-break: break-all;
}
.detail-info__row--place {
  display: block;
  padding: 12rpx 0;
}
.detail-info__row--place .detail-info__k {
  display: block;
  width: auto;
}
.detail-info__row--place .detail-info__v {
  display: block;
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 700;
  text-align: left;
  color: var(--color-text);
  word-break: break-all;
}
.detail-info__v--meta {
  font-size: 24rpx;
  color: var(--color-text-3);
}

/* ---------------- 描述 ---------------- */
.detail-desc__text {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-2);
  white-space: pre-wrap;
  word-break: break-all;
}
.detail-desc__text--clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
}
.detail-desc__toggle {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-primary-dark);
}

/* ---------------- 卖家 ---------------- */
.detail-seller__title {
  margin-bottom: 12rpx;
}
.detail-seller__row {
  display: flex;
  align-items: center;
}
.detail-seller__avatar {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-bg);
  background-color: var(--color-divider);
}
.detail-seller__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--color-primary-dark);
  background-color: var(--color-primary-light);
}
.detail-seller__info {
  display: flex;
  flex-direction: column;
  min-width: 0;
  margin-left: 20rpx;
}
.detail-seller__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.detail-seller__sub {
  margin-top: 2rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}
.detail-seller__role {
  flex: none;
  font-size: 22rpx;
  color: var(--color-text-3);
}

/* ---------------- 无操作提示 / 回首页 ---------------- */
.detail-hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  text-align: center;
  color: var(--color-text-3);
}
.detail-home {
  margin: 24rpx 0 8rpx;
  padding: 20rpx 0;
  text-align: center;
  border-radius: var(--radius);
  background-color: var(--color-bg-white);
  box-shadow: var(--shadow-card);
}
.detail-home--hover {
  background-color: var(--color-bg);
  opacity: 0.9;
}
.detail-home__text {
  font-size: 26rpx;
  color: var(--color-accent);
}

/* ---------------- 底部操作栏 ---------------- */
.detail-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding: 16rpx var(--space-page) calc(16rpx + env(safe-area-inset-bottom));
  background-color: var(--color-bg-white);
  border-top: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-bar);
}
.detail-bar__row {
  display: flex;
  align-items: center;
}
/* 外层格子负责定宽/弹性，按钮只负责撑满格子，避免原生 button 默认 margin 把两个胶囊挤重叠 */
.detail-bar__cell {
  display: flex;
  min-width: 0;
}
.detail-bar__cell--fav {
  flex: 0 0 220rpx;
  width: 220rpx;
}
.detail-bar__cell--contact {
  flex: 1 1 0;
  margin-left: 16rpx;
}
.detail-bar__cell .btn {
  width: 100%;
  margin: 0;
}
.detail-bar__btn {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
  margin: 0;
}
.detail-bar__btn + .detail-bar__btn {
  margin-left: 16rpx;
}
.detail-bar__fav {
  width: 100%;
  padding: 0 12rpx;
  overflow: hidden;
  white-space: nowrap;
}
.detail-bar__fav.detail-bar__fav--on {
  background-color: var(--color-primary-light);
  color: var(--color-primary-dark);
  border-color: transparent;
}
.detail-bar__contact {
  width: 100%;
}

/* ---------------- 小票外壳（移植自 B 的 errand/detail，11-25） ----------------
   纸面 --color-paper 压在 --color-bg 上，上下各一条锯齿边：
   齿距 26rpx（左右各 13rpx 透明 border）、齿高 16rpx，纯 CSS 三角、不用图片。
   rpx 下纸面宽度恒为 686rpx（750 - 两侧 32rpx），27 齿共 702rpx，末齿被 overflow 裁掉。 */
.receipt {
  position: relative;
}
.receipt__body {
  padding: 26rpx 36rpx 34rpx;
  background-color: var(--color-paper);
  box-shadow: var(--shadow-card);
}
.receipt__saw {
  display: flex;
  height: 16rpx;
  overflow: hidden;
}
/* 齿盒必须显式 border-box：content-box 下会变成 26×32，被 16rpx 高的齿条整条裁没 */
.receipt__tooth {
  flex: none;
  box-sizing: border-box;
  width: 26rpx;
  height: 16rpx;
  border-left: 13rpx solid transparent;
  border-right: 13rpx solid transparent;
}
.receipt__tooth--top {
  border-bottom: 16rpx solid var(--color-paper);
}
.receipt__tooth--bottom {
  border-top: 16rpx solid var(--color-paper);
}
/* 小票内卡片不再是独立浮层：去底色 / 圆角 / 阴影 / 内边距 */
.receipt__body .card {
  padding: 0;
  background-color: transparent;
  border-radius: 0;
  box-shadow: none;
}
.receipt__body .card + .card {
  margin-top: 0;
}
/* 分段之间：虚线与上下留白 */
.receipt__body .receipt__sec + .receipt__sec {
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 3rpx dashed var(--color-border);
}

/* ---------------- 小票落款：随机图案 + 日期 + 打印时间 ---------------- */
.receipt-doodle {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.receipt-doodle__img {
  width: 176rpx;
  height: 176rpx;
}
.receipt-doodle__date {
  margin: 4rpx 0 0 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  color: var(--color-text);
}
.receipt-doodle__print {
  margin-top: 10rpx;
  font-size: var(--font-xs);
  color: var(--color-text-3);
}
/* 头像描边原本用页面底色；进小票后改成纸面色，避免深色圈 */
.receipt__body .detail-seller__avatar {
  border-color: var(--color-paper);
}
