<!-- 消息列表（B 成员，11-14，tab 3）：会话卡片 + 未读红点 -->
<nav-top />
<scroll-view
  class="page-scroll"
  scroll-y
  scroll-top="{{svTop}}"
  refresher-enabled
  refresher-default-style="none"
  refresher-background="transparent"
  refresher-triggered="{{pulling}}"
  bindrefresherrefresh="onRefresh"
  bindscrolltolower="onReachBottom"
>
  <view slot="refresher" class="pull-eyes"
    style="width: 100%; box-sizing: border-box; display: flex; align-items: center; justify-content: center; text-align: center; padding: 20rpx 0;"><loading-eyes mini motto="{{false}}" /></view>
<view class="page page--tab page-body">

  <!-- 登录门 -->
  <view wx:if="{{!isLogin}}" class="cl-state">
    <empty-state title="登录后查看消息" desc="与同学的聊天记录都在这里" action-text="去登录" bind:action="onLogin" />
  </view>

  <block wx:else>
    <!-- 首屏加载：眼睛 + 随机短句（全站统一加载态） -->
    <block wx:if="{{firstLoading}}">
      <view class="cl-state cl-state--loading">
        <loading-eyes />
      </view>
    </block>

    <!-- 失败：给重试 -->
    <view wx:elif="{{error}}" class="cl-state">
      <view class="card cl-state__card">
        <text class="t-title">加载失败</text>
        <text class="t-sub cl-state__desc">{{error}}</text>
        <button class="btn btn-primary btn-block" hover-class="btn--press" bindtap="onRetry">重新加载</button>
      </view>
    </view>

    <!-- 真空态：给出路 -->
    <view wx:elif="{{!list.length}}" class="cl-state">
      <empty-state
        title="还没有消息"
        desc="和同学聊过的商品、代取都会出现在这里"
        action-text="去逛逛"
        bind:action="onGoIndex"
      />
    </view>

    <block wx:else>
      <view
        wx:for="{{list}}"
        wx:key="conversationId"
        class="cl-conv"
        data-id="{{item.conversationId}}"
        data-peer="{{item.peerId}}"
        data-biztype="{{item.bizType}}"
        data-bizid="{{item.bizId}}"
        bindtap="onTapConv"
        hover-class="cl-conv--hover"
      >
        <!-- 头像 + 未读红点（角标叠在头像右上） -->
        <view class="cl-conv__avatar-wrap">
          <image wx:if="{{item.avatarUrl}}" class="cl-conv__avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="cl-conv__avatar cl-conv__avatar--text">{{item.initial}}</view>
          <view wx:if="{{item.hasUnread}}" class="cl-conv__badge">{{item.unreadText}}</view>
        </view>

        <view class="cl-conv__body">
          <view class="cl-conv__top">
            <text class="cl-conv__name ellipsis">{{item.peerNickname}}</text>
            <text wx:if="{{item.timeText}}" class="cl-conv__time">{{item.timeText}}</text>
          </view>
          <view class="cl-conv__bottom">
            <text class="cl-conv__last ellipsis">{{item.lastMessage}}</text>
          </view>
        </view>
      </view>

      <view class="cl-more">
        <loading-eyes mini wx:if="{{loadingMore}}" />
        <text wx:elif="{{hasMore}}" class="cl-more__text">上拉加载更多</text>
        <text wx:else class="cl-more__text">没有更多了</text>
      </view>
    </block>
  </block>

  <view class="safe-bottom"></view>
</view>
</scroll-view>
