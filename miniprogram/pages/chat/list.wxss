/* 消息列表（B 成员，11-14） */

/* ---------- 顶部吸顶标题（与二手市场 / 代取大厅同位置） ---------- */
.cl-page {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}
.cl-bar {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 0 var(--space-page) 10rpx;
  background-color: var(--color-bg);
}
.cl-bar__safe {
  overflow: hidden;
}
.cl-bar__head {
  display: flex;
  align-items: center;
}
.cl-bar__title {
  font-size: var(--font-2xl);
  font-weight: 900;
  -webkit-text-stroke: 0.6rpx currentColor;
  color: var(--color-text);
  letter-spacing: 2rpx;
  line-height: 1;
}
.cl-content {
  padding: 0 var(--space-page);
}

.cl-state {
  padding: 40rpx 0;
}
.cl-state__card {
  text-align: center;
}

/* 首屏加载：眼睛无白卡直接居中（11-25，去掉 sk-card 底框） */
.cl-state--loading {
  text-align: center;
  padding: 160rpx 0 40rpx;
}
.cl-state__desc {
  display: block;
  margin: 12rpx 0 24rpx;
}

/* ---- 会话卡片：左滑露出操作 ---- */
.cl-swipe {
  position: relative;
  margin-bottom: 20rpx;
  border-radius: var(--radius-card, 24rpx);
  overflow: hidden;
  /* 卡片左滑后左侧圆角缺口露出的底色，用置顶色补满，与第一个按钮连成一体 */
  background: var(--color-primary-dark, #79513D);
}
.cl-swipe__actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  width: 450rpx;
}
.cl-swipe__action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  color: #ffffff;
  font-size: var(--font-sm, 26rpx);
  font-weight: 600;
  text-align: center;
}
/* 三档暖色令牌：深棕 → 焦糖 → 危险红，与小程序主色同源，不使用外部蓝/土黄 */
.cl-swipe__action--pin {
  /* 与 .cl-swipe 底色同色：卡片圆角缺口 + 尖角都被这一档补满 */
  background: var(--color-primary-dark, #79513D);
}
.cl-swipe__action--unread {
  background: var(--color-accent, #A7724F);
}
.cl-swipe__action--delete {
  background: var(--color-danger, #C62828);
}

.cl-conv {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--color-surface, #ffffff);
  border-radius: var(--radius-card, 24rpx);
  box-shadow: var(--shadow-card);
  transition:
    transform 120ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 120ms cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 200ms ease-out;
}
.cl-conv--hover {
  /* 全站口径：只压暗不缩放（11-25 方案二） */
  opacity: 0.94;
  box-shadow: var(--shadow-card-hover);
}
/* 手指跟随期间关掉过渡，松手再吸到位 */
.cl-conv--swiping {
  transition: none;
}
.cl-conv__pin {
  flex-shrink: 0;
  margin-right: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: var(--color-primary-light, #F7E4CE);
  color: var(--color-primary-dark, #79513D);
  font-size: var(--font-xs, 22rpx);
  line-height: 1.4;
}
.cl-conv__avatar-wrap {
  position: relative;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.cl-conv__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}
.cl-conv__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-soft, #efe4d8);
  color: var(--color-primary-dark);
  font-size: var(--font-lg, 32rpx);
  font-weight: 600;
}
.cl-conv__badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--color-danger, #c0563e);
  color: #ffffff;
  font-size: var(--font-xs, 22rpx);
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
  /* 2rpx 白描边，避免压头像糊（方案 6.9） */
  border: 2rpx solid #ffffff;
}
.cl-conv__body {
  flex: 1;
  min-width: 0;
}
.cl-conv__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cl-conv__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1, #2E2119);
  min-width: 0;
  flex: 1;
}
.cl-conv__time {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--font-xs, 22rpx);
  color: var(--color-text-4, #b3a695);
}
.cl-conv__bottom {
  margin-top: 8rpx;
}
.cl-conv__last {
  font-size: var(--font-sm, 26rpx);
  color: var(--color-text-3, #9a8c7d);
}

.cl-more {
  text-align: center;
  padding: 16rpx 0 8rpx;
}
.cl-more__text {
  font-size: var(--font-xs, 22rpx);
  color: var(--color-text-4, #b3a695);
}
