/* 消息列表（B 成员，11-14） */

.cl-state {
  padding: 40rpx 0;
}
.cl-state__card {
  text-align: center;
}
.cl-state__desc {
  display: block;
  margin: 12rpx 0 24rpx;
}

/* ---- 会话卡片 ---- */
.cl-conv {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: var(--color-surface, #ffffff);
  border-radius: var(--radius-card, 24rpx);
  box-shadow: var(--shadow-card);
  transition:
    transform 120ms cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 200ms ease-out;
}
.cl-conv--hover {
  transform: scale(0.985);
  box-shadow: var(--shadow-card-hover);
}
.cl-conv__avatar-wrap {
  position: relative;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.cl-conv__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}
.cl-conv__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-soft, #efe4d8);
  color: var(--color-primary-dark);
  font-size: var(--font-lg, 32rpx);
  font-weight: 600;
}
.cl-conv__badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--color-danger, #c0563e);
  color: #ffffff;
  font-size: var(--font-xs, 22rpx);
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
  /* 2rpx 白描边，避免压头像糊（方案 6.9） */
  border: 2rpx solid #ffffff;
}
.cl-conv__body {
  flex: 1;
  min-width: 0;
}
.cl-conv__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cl-conv__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1, #2E2119);
  min-width: 0;
  flex: 1;
}
.cl-conv__time {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--font-xs, 22rpx);
  color: var(--color-text-4, #b3a695);
}
.cl-conv__bottom {
  margin-top: 8rpx;
}
.cl-conv__last {
  font-size: var(--font-sm, 26rpx);
  color: var(--color-text-3, #9a8c7d);
}

.cl-more {
  text-align: center;
  padding: 16rpx 0 8rpx;
}
.cl-more__text {
  font-size: var(--font-xs, 22rpx);
  color: var(--color-text-4, #b3a695);
}
