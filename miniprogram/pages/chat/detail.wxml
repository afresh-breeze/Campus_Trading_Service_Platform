<!-- 聊天页（B 成员，11-14）：业务卡片 + 消息气泡（3 秒增量轮询）+ 发送框 -->
<!-- 修复（11-16）：nav-top 挪进 cd-page（100vh flex 列）内部当第一个子元素。
     之前 nav-top 在外面占高度，cd-page 又是 100vh，总高超出视口，
     底部发送框（我方的聊天框）被顶到屏幕外看不见。 -->
<view wx:if="{{fatalError}}" class="page page-body">
  <nav-top back />
  <view class="card cd-fatal">
    <text class="t-title">{{fatalError}}</text>
    <text class="t-sub cd-fatal__desc">{{fatalDesc}}</text>
    <button wx:if="{{canRetry}}" class="btn btn-primary btn-block" bindtap="onRetryInit">重试</button>
    <button wx:else class="btn btn-ghost btn-block" bindtap="onBack">返回</button>
  </view>
</view>

<view wx:elif="{{loading}}" class="page page-body">
  <nav-top back />
  <view class="sk-card">
    <view class="sk-line sk-line--lg"></view>
    <view class="sk-line sk-line--md"></view>
    <view class="sk-line sk-line--sm"></view>
  </view>
</view>

<block wx:else>
  <view class="cd-page">
    <nav-top back title="{{pageTitle}}" />
    <!-- 业务卡片：点击进商品/代取详情；动作仍在详情页做 -->
    <view wx:if="{{bizCard}}" class="cd-biz" bindtap="onBizTap" hover-class="cd-biz--hover">
      <image wx:if="{{bizCard.coverUrl}}" class="cd-biz__cover" src="{{bizCard.coverUrl}}" mode="aspectFill" />
      <view wx:else class="cd-biz__cover cd-biz__cover--text">{{bizType === 'errand' ? '取' : '商'}}</view>
      <view class="cd-biz__info">
        <view class="cd-biz__title-row">
          <text class="cd-biz__title ellipsis">{{bizCard.title}}</text>
          <text class="tag tag-gray">{{bizCard.statusText}}</text>
        </view>
        <text class="cd-biz__sub ellipsis">{{bizCard.subText || bizTitleText}}</text>
      </view>
      <text class="cd-biz__price">{{bizCard.mainText}}</text>
    </view>
    <view wx:else class="cd-biz-sub">
      <text class="cd-biz-sub__text">{{bizTitleText}}</text>
    </view>

    <!-- 消息区：scroll-into-view 锚点滚底；只在新消息且在底部时滚 -->
    <scroll-view
      class="cd-scroll"
      scroll-y
      scroll-into-view="{{scrollAnchor}}"
      scroll-with-animation
      bindscrolltoupper="onScrollToUpper"
      bindscrolltolower="onScrollToLower"
    >
      <view wx:if="{{!messages.length}}" class="cd-empty">
        <text class="cd-empty__text">还没有消息，打个招呼吧</text>
      </view>

      <block wx:for="{{messages}}" wx:key="key">
        <!-- 时间分隔：与上一条间隔 > 5 分钟才显示 -->
        <view wx:if="{{item.showTime}}" class="cd-time">
          <text class="cd-time__text">{{item.timeText}}</text>
        </view>

        <view class="cd-row {{item.isMine ? 'cd-row--mine' : ''}}">
          <view
            class="cd-bubble {{item.isMine ? 'cd-bubble--mine' : ''}} {{item.failed ? 'cd-bubble--failed' : ''}}"
            data-content="{{item.content}}"
            bindlongpress="onLongPressMsg"
            data-temp="{{item.tempId}}"
            bindtap="{{item.failed ? 'onTapFailed' : ''}}"
          >
            <image wx:if="{{item.isImage}}" class="cd-bubble__img" src="{{item.imageUrl}}" mode="aspectFill" />
            <text wx:else class="cd-bubble__text">{{item.content}}</text>
            <view wx:if="{{item.pending}}" class="cd-bubble__status">发送中…</view>
            <view wx:elif="{{item.failed}}" class="cd-bubble__status cd-bubble__status--fail">发送失败，点击重发</view>
          </view>
        </view>
      </block>

      <view id="anchor-bottom" class="cd-anchor"></view>
    </scroll-view>

    <!-- 发送框 -->
    <view class="cd-inputbar">
      <input
        class="cd-inputbar__input"
        value="{{input}}"
        maxlength="500"
        confirm-type="send"
        adjust-position="{{true}}"
        placeholder="输入消息…"
        placeholder-class="cd-inputbar__placeholder"
        bindinput="onInput"
        bindconfirm="onSend"
      />
      <!-- 间隙用实体 view 占位：button 组件吞掉类选择器的 margin-left（实测渲染为 0），
           与 width:184px 同源的默认样式怪癖，宽度/间距一律走内联或实体元素 -->
      <view class="cd-inputbar__gap" />
      <button
        class="cd-inputbar__send {{input ? 'cd-inputbar__send--on' : ''}}"
        style="width: 100rpx; min-width: 0; padding: 0;"
        bindtap="onSend"
      >发送</button>
    </view>
  </view>
</block>
