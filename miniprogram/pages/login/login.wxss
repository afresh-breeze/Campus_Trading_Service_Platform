/* ==================================================================
   登录页（B 成员）—— 黄屏扁平底 + 眼睛条开场
   ------------------------------------------------------------------
   1) 整页底色 #FDE03F 扁平（原弥散层已按用户定稿移除）；
   2) 开场编排 2600ms：裸眼放大悬在屏幕正中（左→右→中→下扫视）→
      内容层从下方平滑入场，眼睛条带轻微果冻上升到导航下方插槽；
      落定后眼睛条用 loading-eyes 同款 eyes-move/eyes-blink 待机；
   3) 输密码：bindfocus/bindblur 切 .closed —— 眼白淡出，只剩两条
      瞳孔同色的圆头粗线（左 > 右 <，基础画法尖角朝左即 <，> 取镜像）；
   4) 编排动画全部挂 .intro，播完由 js 摘类回最终态
      （同 detail-page-enter 口径）；内容层 66% 才起步，避免标题
      在眼睛经过标题区时追上来造成重合。
   ================================================================== */

/* 黄屏层：整页底色（含状态栏与导航区后面） */
page {
  background-color: #FDE03F;
}

.login-page {
  position: relative;
  overflow: hidden;
  min-height: 100vh;
  padding: 0 48rpx 60rpx;
  background: transparent;
}

/* ---------------- 内容层（入场动画载体） ---------------- */
.login-body {
  /* 无额外布局，只作 login-rise 的动画挂点 */
}

/* ---------------- 标题 ---------------- */
.hero {
  padding: 200rpx 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hero-title {
  font-size: 74rpx;
  /* 全站宋体（衬线）下大标题统一 900 + 细描边（.home-bar__title 口径） */
  font-weight: 900;
  -webkit-text-stroke: 0.8rpx currentColor;
  letter-spacing: 8rpx;
  /* 字距会在尾部多出一份，等量缩进抵消保持视觉居中 */
  text-indent: 8rpx;
  line-height: 1.25;
  color: var(--color-text);
}

/* ---------------- 表单卡 ---------------- */
.form-card {
  margin-top: 140rpx;
  border-radius: 32rpx;
  background-color: var(--color-bg-white);
  box-shadow: 0 16rpx 56rpx rgba(121, 81, 61, 0.18);
  overflow: hidden;
}
.form-card .field {
  height: 112rpx;
}
.form-card .field:last-child {
  border-bottom: none;
}
.form-card .field-label {
  /* 全局 150rpx 为长标签留的，登录页只有两个字，收窄让输入区更靠左 */
  width: 96rpx;
  font-weight: 500;
  color: var(--color-text-2);
}

/* ---------------- 登录按钮：独立成行，主行动层级 ---------------- */
.submit {
  margin-top: 120rpx;
  height: 96rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
}

/* ---------------- 底部链接与协议：黄底上加深保证对比度 ---------------- */
.extra {
  padding: 44rpx 8rpx 0;
}
.extra-link {
  color: #4A3A2C;
  font-weight: 600;
}
.agreement {
  margin-top: 84rpx;
  text-align: center;
  font-size: var(--font-xs);
  color: #5C4A38;
}
/* 协议可点：下划线 + 强调色，不依赖颜色单独传达 */
.agreement__link {
  color: var(--color-primary-dark);
  font-weight: 700;
  text-decoration: underline;
}
.tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: var(--font-xs);
  color: #8A4A00;
  font-weight: 600;
}

/* ==================================================================
   眼睛条：几何沿用 loading-eyes 组件（eye 64 / pupil 40 / travel ±20 /
   gap 12，单位 rpx），黄底裸眼不加白色胶囊底
   ================================================================== */
.eyes-bar {
  position: absolute;
  left: 50%;
  width: 400rpx;
  height: 92rpx;
  margin-left: -200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  pointer-events: none;
  z-index: 3;
}

.eye {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--color-bg-white);
  box-shadow: 0 2rpx 6rpx rgba(121, 81, 61, 0.16);
  overflow: hidden;
  animation: eyes-blink var(--dur, 10000ms) infinite;
}
.eye + .eye {
  margin-left: 12rpx;
}
.pupil {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 40rpx;
  height: 40rpx;
  margin: -20rpx 0 0 -20rpx;
  border-radius: 50%;
  background-color: var(--color-primary-dark);
  transition: opacity 120ms ease;
}

/* 待机扫视：与 loading-eyes 完全同拍（中→左→右→下→回中，循环无缝） */
@keyframes eyes-move {
  0% {
    transform: translate(0, 0);
  }
  4%, 40% {
    transform: translate(-20rpx, 0);
  }
  43%, 70% {
    transform: translate(20rpx, 0);
  }
  73%, 90% {
    transform: translate(0, 20rpx);
  }
  93%, 100% {
    transform: translate(0, 0);
  }
}
/* 眨眼：与 loading-eyes 同拍（每次转向前眯一下） */
@keyframes eyes-blink {
  0%, 2%, 10%, 12%, 20%, 22%, 40%, 42%, 60%, 62%, 70%, 72%, 90%, 92%, 98%, 100% {
    height: 64rpx;
  }
  1%, 11%, 21%, 41%, 61%, 71%, 91%, 99% {
    height: 24rpx;
  }
}

/* ==================================================================
   开场编排（2600ms，js 在 2800ms 摘 .intro）
   ================================================================== */

/* —— 眼睛条：屏中放大 → 上升（轻微果冻）→ 插槽落定 —— */
.intro .eyes-bar {
  animation: bar-journey 2600ms cubic-bezier(0.45, 0.05, 0.55, 0.95) both;
}
/* --bar-from 由 js 计算：屏高正中 − 插槽位，保证开场落在全屏正中央 */
@keyframes bar-journey {
  0% {
    transform: translateY(var(--bar-from, 300px)) scale(2.2);
  }
  6%, 46% {
    transform: translateY(var(--bar-from, 300px)) scale(2.2);
  }
  62% {
    transform: translateY(240rpx) scale(1.18);
  }
  72% {
    transform: translateY(-24rpx) scale(0.97);
  }
  80% {
    transform: translateY(8rpx) scale(1.02);
  }
  88%, 100% {
    transform: translateY(0) scale(1);
  }
}

/* —— 开场扫视：左 → 右 → 中 → 下（下望的同时条上升）→ 回中交接给待机 —— */
.intro .pupil {
  animation: splash-look 2600ms cubic-bezier(0.45, 0.05, 0.55, 0.95) both,
    eyes-move var(--dur, 10000ms) linear 2600ms infinite;
}
@keyframes splash-look {
  0%, 6% {
    transform: translate(0, 0);
  }
  14%, 24% {
    transform: translate(-20rpx, 0);
  }
  32%, 42% {
    transform: translate(20rpx, 0);
  }
  48%, 54% {
    transform: translate(0, 0);
  }
  60%, 72% {
    transform: translate(0, 20rpx);
  }
  80%, 100% {
    transform: translate(0, 0);
  }
}

/* —— 内容层：66% 才起步，眼睛先落定（88% 前），标题 92% 才到位 —— */
.intro .login-body {
  animation: login-rise 2600ms var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
}
@keyframes login-rise {
  0%, 66% {
    transform: translateY(100%);
  }
  92% {
    transform: translateY(0);
  }
  100% {
    transform: translateY(0);
  }
}

/* ---------------- 输密码：> < 眯眼 ---------------- */
/* 圆头短棒两段、不对称角度拼出 > <，尾部略长，模仿手笔柔和收尾 */
.sq {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 36rpx;
  height: 36rpx;
  margin: -18rpx 0 0 -18rpx;
  opacity: 0;
  transition: opacity 140ms ease;
}
.sq .seg {
  position: absolute;
  left: 0;
  top: 13rpx;
  width: 34rpx;
  height: 10rpx;
  border-radius: 10rpx;
  background-color: var(--color-primary-dark);
  transform-origin: left center;
}
.sq .seg--up {
  transform: rotate(-33deg);
}
.sq .seg--dn {
  transform: rotate(41deg);
}
/* 基础画法：尖角在左、开口朝右，即 <；左眼要 >，整组水平镜像成尖角朝右 */
.sq--gt {
  transform: scaleX(-1);
}
.eyes-bar.closed .eye {
  background-color: transparent;
  box-shadow: none;
}
.eyes-bar.closed .sq {
  opacity: 1;
}
.eyes-bar.closed .pupil {
  opacity: 0;
}

/* 系统开启「减弱动态效果」时跳过编排，直接给最终态 */
@media (prefers-reduced-motion: reduce) {
  .intro .eyes-bar,
  .intro .pupil,
  .intro .login-body {
    animation: none;
    transform: none;
  }
  .intro .pupil {
    opacity: 1;
  }
  .eye {
    animation: none;
  }
}
