<!-- 登录页（B 成员） -->
<nav-top back />
<view class="page login-page {{intro ? 'intro' : ''}}">
  <!-- 弥散背景：fixed 铺满全屏（含状态栏与导航区），z-index:-1 保证不挡返回按钮 -->
  <view class="mesh">
    <view class="mesh__blob mesh__blob--1"></view>
    <view class="mesh__blob mesh__blob--2"></view>
    <view class="mesh__blob mesh__blob--3"></view>
    <view class="mesh__blob mesh__blob--4"></view>
  </view>

  <view class="hero">
    <!-- 开场主角：小光晕弹跳入位后散开（纯装饰，不接事件） -->
    <view class="glow-ring"></view>
    <view class="glow"></view>
    <!-- 落定后常驻的呼吸光晕，承担品牌位（替代原 logo 块） -->
    <view class="hero-halo"></view>
    <view class="hero-title">校园易站</view>
  </view>

  <view class="form-card">
    <view class="field">
      <text class="field-label">学号</text>
      <input
        class="field-input"
        type="number"
        maxlength="20"
        placeholder="请输入学号（6-20 位数字）"
        placeholder-class="field-placeholder"
        value="{{studentNo}}"
        bindinput="onStudentNoInput"
      />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input
        class="field-input"
        password="{{true}}"
        maxlength="20"
        placeholder="请输入密码（6-20 位）"
        placeholder-class="field-placeholder"
        value="{{password}}"
        bindinput="onPasswordInput"
        bindconfirm="onSubmit"
      />
    </view>
  </view>

  <button class="btn btn-primary btn-block submit" loading="{{submitting}}" disabled="{{submitting}}" hover-class="btn--press" bindtap="onSubmit">
    登录
  </button>

  <view class="row-between extra">
    <text class="t-sub" bindtap="onGoRegister">还没有账号？去注册</text>
    <text class="t-sub" bindtap="onForget">忘记密码</text>
  </view>

  <!-- 协议可点：弹摘要，不假装有独立页面（P2-2） -->
  <view class="agreement t-sub">
    <text>登录即表示同意</text>
    <text class="agreement__link" data-type="user" bindtap="onOpenAgreement">《用户协议》</text>
    <text>与</text>
    <text class="agreement__link" data-type="privacy" bindtap="onOpenAgreement">《隐私政策》</text>
  </view>

  <view class="tip t-sub" wx:if="{{isMock}}">当前为本地模拟数据模式（config.js 中 MOCK = true）</view>
</view>
