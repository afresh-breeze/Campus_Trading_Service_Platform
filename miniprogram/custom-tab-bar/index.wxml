<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-bar__item {{selected === index ? 'tab-bar__item--active' : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-bar__dot {{selected === index ? 'tab-bar__dot--show' : ''}}"></view>
    <text class="tab-bar__text">{{item.text}}</text>
  </view>
</view>
