<view class="tab-bar">
  <view
    class="tab-bar__pill"
    style="left: calc({{selected * 25}}% + 8rpx); {{animate ? '' : 'transition: none;'}}"
  ></view>
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-bar__item {{activeIndex === index ? 'tab-bar__item--active' : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-bar__icon-wrap">
      <image class="tab-bar__icon" src="{{item.icon}}" mode="aspectFit" />
      <image class="tab-bar__icon tab-bar__icon--on" src="{{item.iconActive}}" mode="aspectFit" />
    </view>
    <text class="tab-bar__text">{{item.text}}</text>
    <view wx:if="{{index === 2 && badge > 0}}" class="tab-bar__badge">{{badge > 99 ? '99+' : badge}}</view>
  </view>
</view>
