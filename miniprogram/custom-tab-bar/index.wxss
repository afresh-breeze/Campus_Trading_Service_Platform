.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #ffffff;
  border-top: 1rpx solid var(--color-divider, #F7EEE1);
  z-index: 100;
}

.tab-bar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-bar__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: transparent;
}

.tab-bar__dot--show {
  background-color: var(--color-primary, #FFA726);
}

/* 文字 40rpx：原生 tabBar 文字为 20rpx（10px），放大两倍 */
.tab-bar__text {
  font-size: 40rpx;
  line-height: 1.1;
  color: var(--color-text-2, #6B6259);
}

.tab-bar__item--active .tab-bar__text {
  color: var(--color-primary-dark, #A94A00);
  font-weight: 600;
}

.tab-bar__item:active {
  opacity: 0.8;
}
