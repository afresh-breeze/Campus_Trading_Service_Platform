.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 80rpx;
}

/* 用几何图形拼一个空盒子，避免依赖图片资源 */
.empty__art {
  width: 160rpx;
  height: 140rpx;
  position: relative;
  margin-bottom: 40rpx;
}

.empty__box {
  position: absolute;
  left: 30rpx;
  bottom: 0;
  width: 100rpx;
  height: 76rpx;
  border: 4rpx solid var(--color-border, #E9DFD0);
  border-radius: 10rpx;
  background: var(--color-primary-light, #FCDBA9);
}

.empty__line {
  position: absolute;
  left: 52rpx;
  top: 34rpx;
  width: 56rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--color-border, #E9DFD0);
}

.empty__line--short {
  top: 14rpx;
  left: 64rpx;
  width: 32rpx;
}

.empty__title {
  font-size: 30rpx;
  color: var(--color-text-2, #6B5B4D);
  font-weight: 500;
}

.empty__desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--color-text-3, #9A8875);
  line-height: 1.6;
  text-align: center;
}

.empty__btn {
  margin-top: 40rpx;
  height: 72rpx;
  padding: 0 48rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #fff;
  background: var(--color-primary-dark, #79513D);
}

.empty__btn:active {
  opacity: 0.85;
}
