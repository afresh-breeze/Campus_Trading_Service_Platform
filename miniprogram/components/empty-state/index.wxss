.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 80rpx;
}

/* 用几何图形拼一个空盒子，避免依赖图片资源 */
/* UI 优化 5.4（11-22）：柔光晕 + 3.2s 轻微上下浮动，避免“死图” */
.empty__art {
  width: 160rpx;
  height: 140rpx;
  position: relative;
  margin-bottom: 40rpx;
}

.empty__art::before {
  content: '';
  position: absolute;
  left: -20rpx;
  right: -20rpx;
  top: 10rpx;
  bottom: -16rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(230, 168, 116, 0.18), transparent 70%);
}

.empty__box {
  position: absolute;
  left: 30rpx;
  bottom: 0;
  width: 100rpx;
  height: 76rpx;
  border: 4rpx solid var(--color-border, #E9DFD0);
  border-radius: 10rpx;
  background: var(--color-primary-light, #FCDBA9);
  animation: empty-float 3.2s ease-in-out infinite;
}

@keyframes empty-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

.empty__line {
  position: absolute;
  left: 52rpx;
  top: 34rpx;
  width: 56rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--color-border, #E9DFD0);
}

.empty__line--short {
  top: 14rpx;
  left: 64rpx;
  width: 32rpx;
}

.empty__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-2, #6B5B4D);
}

.empty__desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--color-text-3, #9A8875);
  line-height: 1.6;
  text-align: center;
}

.empty__btn {
  margin-top: 40rpx;
  height: 80rpx;
  padding: 0 48rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #fff;
  background: var(--color-primary-dark, #79513D);
  transition:
    transform 120ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 120ms cubic-bezier(0.22, 1, 0.36, 1);
}

.empty__btn--hover {
  opacity: 0.92;
}
