.card {
  background: var(--color-bg-white, #FFFFFF);
  overflow: hidden;
}

/* ---------- grid：两列瀑布流 ---------- */
.card--grid {
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(120, 80, 20, 0.08);
}

.card--grid .card__cover {
  position: relative;
  width: 100%;
  height: 320rpx;
}

.card--grid .card__body {
  padding: 16rpx 18rpx 20rpx;
}

.card--grid .card__title {
  font-size: 28rpx;
  color: var(--color-text, #2B2622);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 80rpx;
}

/* ---------- list：单列横向 ---------- */
.card--list {
  display: flex;
  padding: 20rpx;
  border-radius: 16rpx;
}

.card--list .card__cover {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
}

.card--list .card__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.card--list .card__title {
  font-size: 30rpx;
  color: var(--color-text, #2B2622);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---------- 通用 ---------- */
.card__img {
  width: 100%;
  height: 100%;
  display: block;
  background: var(--color-primary-light, #FFF3E0);
}

.card__img--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-text-4, #C4B8AA);
}

.card__tag {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
}

.card__meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #9E9E9E;
}

.card__meta-item {
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card__dot {
  margin: 0 8rpx;
}

.card__foot {
  margin-top: auto;
  padding-top: 12rpx;
  display: flex;
  align-items: baseline;
}

.card__price {
  display: flex;
  align-items: baseline;
  color: var(--color-price, #D84315);
}

.card__yuan {
  font-size: 22rpx;
  font-weight: 600;
}

.card__num {
  font-size: 34rpx;
  font-weight: 600;
  margin-left: 2rpx;
}

.card__origin {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-4, #C4B8AA);
  text-decoration: line-through;
}

.card__state {
  margin-left: auto;
}

.card--hover {
  opacity: 0.9;
}
