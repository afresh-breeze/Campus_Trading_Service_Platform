/* 地点选择弹层（B 成员，11-15）：只引用 app.wxss 的设计令牌 */
.pp-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background-color: rgba(43, 30, 20, 0.45);
}
.pp-panel {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 80vh;
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: var(--radius-lg, 24rpx) var(--radius-lg, 24rpx) 0 0;
  background-color: var(--color-bg-white);
}
.pp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space) var(--space) 0;
}
.pp-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
}
.pp-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: var(--color-bg);
  font-size: var(--font-base);
  color: var(--color-text-3);
}

/* ---------------- 搜索 ---------------- */
.pp-search {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin: var(--space-sm) var(--space) 0;
  padding: 0 24rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-bg);
}
.pp-search__icon {
  position: relative;
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-right: 14rpx;
  border: 3rpx solid var(--color-text-3);
  border-radius: 50%;
}
.pp-search__icon::after {
  content: '';
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background-color: var(--color-text-3);
  transform: rotate(45deg);
  transform-origin: left center;
}
.pp-search__input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: var(--font-base);
  color: var(--color-text);
}
.pp-search__ph {
  color: var(--color-text-4);
}
.pp-clear {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: var(--color-divider);
  font-size: 22rpx;
  color: var(--color-text-3);
}

/* ---------------- 主体 ---------------- */
.pp-body {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
  padding: var(--space-sm) var(--space);
  box-sizing: border-box;
}
.pp-empty {
  padding: var(--space-xl) 0;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-text-3);
}

/* 搜索命中行 */
.pp-hit {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.pp-hit--hover {
  background-color: var(--color-bg);
}
.pp-hit__name {
  font-size: var(--font-base);
  color: var(--color-text);
}
.pp-hit__zone {
  flex: none;
  margin-left: var(--space-sm);
  font-size: var(--font-xs);
  color: var(--color-text-3);
}

/* 分类横滑 */
.pp-cats {
  width: 100%;
  height: 56rpx;
  white-space: nowrap;
}
.pp-cats::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}
.pp-cat {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 24rpx;
  margin-right: var(--space-sm);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-full);
  background-color: var(--color-bg-white);
  font-size: 24rpx;
  color: var(--color-text-2);
  vertical-align: top;
}
.pp-cat--active {
  border-color: transparent;
  background-color: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-weight: 600;
}

/* 片区 / 地标网格 */
.pp-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--space-sm);
}
.pp-zone,
.pp-place {
  flex: none;
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 22rpx;
  margin: 0 12rpx 12rpx 0;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-full);
  background-color: var(--color-bg-white);
  font-size: 24rpx;
  color: var(--color-text-2);
}
.pp-zone--active,
.pp-place--active {
  border-color: transparent;
  /* 主色 #E6A874 太浅压不住白字，选中态用深棕（同 btn-primary 的对比度口径） */
  background-color: var(--color-primary-dark);
  color: #ffffff;
  font-weight: 600;
}
.pp-places-title {
  margin-top: var(--space);
  font-size: var(--font-xs);
  color: var(--color-text-3);
}
.pp-places-tip {
  margin-top: var(--space);
  font-size: var(--font-xs);
  color: var(--color-text-3);
}

/* ---------------- 底部：预览 + 确定 ---------------- */
.pp-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space);
  border-top: 1rpx solid var(--color-divider);
}
.pp-preview {
  flex: 1;
  min-width: 0;
  font-size: var(--font-sm);
  color: var(--color-text-2);
}
.pp-confirm {
  flex: none;
  min-width: 160rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background-color: var(--color-primary-dark);
  font-size: var(--font-base);
  font-weight: 600;
  color: #ffffff;
  padding: 0;
  margin: 0;
  line-height: 68rpx;
}
.pp-confirm--disabled {
  background-color: var(--color-divider);
  color: var(--color-text-3);
}
/* 隐藏 button 默认边框（小程序 button 有 ::after 边框） */
.pp-confirm::after {
  border: none;
}
