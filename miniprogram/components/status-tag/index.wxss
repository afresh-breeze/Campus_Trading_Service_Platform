.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  /* 22rpx 在真机上偏小（UI 走查 11-11 记录 #6），提到 24rpx */
  font-size: 24rpx;
  line-height: 1;
  white-space: nowrap;
}

/* 实心（plain = false）——白字压深色底，亮橙上不放白字 */
.tag--primary { color: #fff; background: var(--color-primary-dark, #79513D); }
.tag--warning { color: #fff; background: var(--color-warning, #B45309); }
.tag--success { color: #fff; background: var(--color-success, #1F7A45); }
.tag--muted   { color: #fff; background: var(--color-text-2, #6B5B4D); }

/* 描边浅底（默认）——浅橙底上文字用深棕，保证可读 */
.tag--plain.tag--primary { color: var(--color-primary-dark, #79513D); background: rgba(230,168,116,0.18); }
.tag--plain.tag--warning { color: var(--color-warning, #B45309); background: rgba(180,83,9,0.12); }
.tag--plain.tag--success { color: var(--color-success, #1F7A45); background: rgba(31,122,69,0.12); }
/* 灰标签原来是 #9A8875 压在 #F1EAE0 上（约 2.2:1，几乎看不清），改用深一档的次级文字色 */
.tag--plain.tag--muted   { color: var(--color-text-2, #6B5B4D); background: var(--color-divider, #F1EAE0); }
