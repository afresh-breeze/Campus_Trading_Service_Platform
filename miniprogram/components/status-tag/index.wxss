.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1;
  white-space: nowrap;
}

/* 实心（plain = false） */
.tag--primary { color: #fff; background: var(--color-primary, #FFA726); }
.tag--warning { color: #fff; background: var(--color-warning, #FF8A3D); }
.tag--success { color: #fff; background: var(--color-success, #4CAF50); }
.tag--muted   { color: #fff; background: #BDBDBD; }

/* 描边浅底（默认） */
.tag--plain.tag--primary { color: var(--color-primary, #FFA726); background: rgba(255,167,38,0.12); }
.tag--plain.tag--warning { color: var(--color-warning, #FF8A3D); background: rgba(255,138,61,0.12); }
.tag--plain.tag--success { color: var(--color-success, #4CAF50); background: rgba(76,175,80,0.12); }
.tag--plain.tag--muted   { color: #9E9E9E; background: #F2F2F2; }
