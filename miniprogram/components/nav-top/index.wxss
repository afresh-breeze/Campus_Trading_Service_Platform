/* 顶部安全区：透明占位，不挡下方内容点击 */
.nav-top {
  position: relative;
  width: 100%;
  pointer-events: none;
}

/* 非固定：bar 就是普通占位（原行为，所有既有页面不变） */
.nav-top__bar {
  position: relative;
  width: 100%;
}

/* fixed=true：bar 悬浮在屏幕顶 + 不透明背景，内容靠 __ph 占位不被盖 */
.nav-top__bar--fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  /* UI 优化 5.5：半透明暖米底 + 可选模糊，实色兜底保留 */
  background: rgba(244, 241, 231, 0.92);
  backdrop-filter: saturate(160%) blur(20rpx);
}

/* 悬浮返回按钮（仅二级页且有页面栈时出现） */
.nav-top__back {
  position: absolute;
  left: 20rpx;
  bottom: 6rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(120, 80, 20, 0.08));
  pointer-events: auto;
  transition:
    transform 120ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 120ms cubic-bezier(0.22, 1, 0.36, 1);
}

.nav-top__back--hover {
  transform: scale(0.94);
  opacity: 0.9;
}

.nav-top__chevron {
  width: 16rpx;
  height: 16rpx;
  border-left: 4rpx solid var(--color-text, #2E2119);
  border-bottom: 4rpx solid var(--color-text, #2E2119);
  transform: rotate(45deg);
  margin-left: 6rpx;
}

/* 可选标题（默认不用，留作特殊页） */
.nav-top__title {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 14rpx;
  text-align: center;
  font-size: var(--font-lg, 32rpx);
  font-weight: 600;
  color: var(--color-text, #2E2119);
  pointer-events: none;
}
