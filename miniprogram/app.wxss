/**
 * 全局样式（B 成员：公共层）
 * ------------------------------------------------------------------
 * 设计令牌 + 通用原子类。页面样式只允许引用这里的变量/类，
 * 不允许再出现魔法色值，方便后期统一改主题。
 */

page {
  /* 主色：奶茶色系（#F4F1E7/#FCDBA9/#E6A874/#A7724F/#79513D/#6A4431） */
  --color-primary: #E6A874;
  --color-primary-light: #FCDBA9;
  --color-primary-dark: #79513D;

  /* 辅助色 */
  --color-accent: #A7724F;
  /* 价格色：焦糖棕，白底大字号可读 */
  --color-price: #A7724F;
  --color-success: #1F7A45;
  --color-warning: #B45309;
  --color-danger: #C62828;

  /* 中性色（暖奶茶调） */
  --color-text: #2E2119;
  /* 11-25 全站宋体后次/辅级视觉对比度变浅（衬线笔画细），两档中性色同步加深：
     text-2 #6B5B4D→#594A3B、text-3 #9A8875→#7E6C5A，仍为暖棕调；
     白底对比度分别约 5.5:1→7.4:1、3.5:1→4.9:1 */
  --color-text-2: #594A3B;
  --color-text-3: #7E6C5A;
  --color-text-4: #C7B9A8;
  --color-border: #E9DFD0;
  --color-divider: #F1EAE0;
  --color-bg: #F4F1E7;
  --color-bg-white: #FFFFFF;
  /* 小票纸面（11-25）：比纯白偏暖一点点，压在 --color-bg 上才有「一张纸」的层次 */
  --color-paper: #FFFDF7;
  /* 按压反馈面（hover-class）：与 divider 同色。
     11-18 A 复查：此前 hall/profile/settings/help 用了它但这里没定义，hover 反馈实际不生效 */
  --color-surface-2: #F1EAE0;

  /* 圆角 / 阴影 / 间距 */
  --radius-sm: 8rpx;
  --radius: 16rpx;
  --radius-lg: 24rpx;
  --radius-full: 999rpx;
  --shadow-card: 0 4rpx 16rpx rgba(122, 93, 64, 0.08);
  --shadow-float: 0 8rpx 24rpx rgba(230, 168, 116, 0.35);
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;

  /* 字号层级 */
  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-base: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-2xl: 44rpx;

  /* ---- UI 优化方案 4.1（11-22）：节奏 / 动效 / 阴影令牌 ---- */
  --space-page: 32rpx;
  --space-section: 48rpx;
  --radius-card: 24rpx;
  --radius-inner: 16rpx;

  --dur-fast: 120ms;
  --dur-base: 200ms;
  --dur-slow: 320ms;
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-in: cubic-bezier(0.4, 0, 1, 1);
  --ease-spring: cubic-bezier(0.34, 1.3, 0.64, 1);

  /* 覆盖原 --shadow-card：两层柔影，贴近的 2rpx + 扩散 12rpx，避免黑色重影 */
  --shadow-card:
    0 2rpx 4rpx rgba(121, 81, 61, 0.04),
    0 12rpx 32rpx rgba(121, 81, 61, 0.08);
  --shadow-card-hover:
    0 4rpx 12rpx rgba(121, 81, 61, 0.06),
    0 20rpx 48rpx rgba(121, 81, 61, 0.12);
  --shadow-bar: 0 -8rpx 32rpx rgba(121, 81, 61, 0.08);

  /* 兼容别名：B 的旧页面止血（方案 4.1），后续 P2 再逐页替换为正式令牌 */
  --color-surface: var(--color-bg-white);
  --color-primary-soft: var(--color-primary-light);
  --color-text-1: var(--color-text);
  --color-primary-strong: var(--color-primary-dark);
  --font-md: var(--font-base);

  background-color: var(--color-bg);
  color: var(--color-text);
  font-size: var(--font-base);
  /* 11-25 用户定稿：全站宋体（衬线）。
     iOS 用系统 Songti SC；macOS STSong；部分 Android 有 Noto Serif CJK；
     Windows 微软雅黑栈里没有宋体，兜底 FangSong/SimSun。
     Android 无宋体的机型会静默回退黑体——如需全端一致，
     后续可用开源思源宋体（OFL 协议）wx.loadFontFace 内嵌子集（宋体 SC/SimSun 有版权不可内嵌） */
  font-family: 'Songti SC', 'STSong', 'Noto Serif CJK SC', 'FangSong', 'SimSun', serif;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
button,
scroll-view {
  box-sizing: border-box;
}

/* 11-25 全站宋体后：44rpx 页面大标题 700 视觉偏细，统一提 900 + 0.6rpx 细描边。
   此规则覆盖 A 页面（二手市场 .home-bar__title）与 B 页面（代取大厅，B 页内已同步）——
   公共层统一改标题字重，需在群里同步告知 A */
.home-bar__title,
.hall-bar__title {
  font-weight: 900;
  -webkit-text-stroke: 0.6rpx currentColor;
}

/* ---------------- 布局 ---------------- */
.row {
  display: flex;
  align-items: center;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.col {
  display: flex;
  flex-direction: column;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------------- 容器 ---------------- */
.page {
  min-height: 100vh;
  background-color: var(--color-bg);
}

/* 自定义下拉刷新（11-25）：原生三点条样式换不了，改 scroll-view refresher 放眼睛 */
.page-scroll {
  height: 100vh;
  box-sizing: border-box;
}
/* fixed 导航页（Mode A）：滚动容器在导航占位之下，flex 撑满剩余高度（高度由页面按 stickyTop 内联给定） */
.sv-flex {
  display: flex;
  flex-direction: column;
}
.page-scroll--fill {
  flex: 1;
  min-height: 0;
}
/* refresher 区：眼睛居中 */
.pull-eyes {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
}
/* B-2：底部避让只属于 tab 页（悬浮胶囊 tabBar 会遮挡内容），
   非 tab 页（详情/发布等）不再多出一条底部留白 */
.page--tab {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}
.page-body {
  padding: var(--space-page);
}
.card {
  background-color: var(--color-bg-white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  padding: 28rpx;
}
.card + .card {
  margin-top: 20rpx;
}

/* ---------------- 文字 ---------------- */
.t-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}
.t-base {
  font-size: var(--font-base);
  color: var(--color-text);
}
.t-sub {
  font-size: var(--font-sm);
  color: var(--color-text-3);
}
.t-price {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-danger);
}
.t-price::before {
  content: '¥';
  font-size: var(--font-sm);
  margin-right: 2rpx;
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* ---------------- 按钮 ---------------- */
.btn {
  /* 小程序原生 button 自带默认内边距，单靠 line-height 居中会被顶偏，
     改用 flex 双向居中并清零内边距（登录按钮文字偏下的修复） */
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0;
  line-height: 1;
  text-align: center;
  border-radius: var(--radius-full);
  font-size: var(--font-lg);
  font-weight: 500;
  background-color: var(--color-bg-white);
  color: var(--color-text);
  border: none;
  transition:
    transform var(--dur-fast) var(--ease-out),
    opacity var(--dur-fast) var(--ease-out),
    box-shadow var(--dur-base) ease-out;
}
.btn--press {
  /* 对齐 A 侧口径：按压只压暗不缩放——scale 会让文字逐帧重新栅格化，出现「字抖动」 */
  opacity: 0.92;
}
.btn::after {
  border: none;
}
.btn-primary {
  /* 白字只能压 primary-dark；primary(#E6A874) 上白字约 2:1，红线禁止 */
  background-color: var(--color-primary-dark);
  color: #ffffff;
  box-shadow: var(--shadow-float);
}
.btn-primary[disabled] {
  background-color: #EBDCC3;
  color: #9A8875;
  box-shadow: none;
}
.btn-ghost {
  background-color: var(--color-bg-white);
  color: var(--color-primary-dark);
  border: 1rpx solid var(--color-primary-dark);
}
.btn-danger {
  background-color: var(--color-danger);
  color: #ffffff;
}
.btn-block {
  width: 100%;
}
.btn-sm {
  height: 60rpx;
  line-height: 58rpx;
  font-size: var(--font-sm);
  padding: 0 24rpx;
}

/* ---------------- 表单 ---------------- */
.field {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 var(--space);
  background-color: var(--color-bg-white);
  border-bottom: 1rpx solid var(--color-divider);
}
.field-label {
  width: 150rpx;
  font-size: var(--font-base);
  color: var(--color-text);
}
.field-input {
  flex: 1;
  font-size: var(--font-base);
  color: var(--color-text);
}
.field-placeholder {
  color: var(--color-text-4);
}
/* 字段级错误：外面套一层 .field-wrap，错误行贴在输入行下方，
   避免破坏 .field 的 96rpx 等高横排 */
.field-wrap {
  background-color: var(--color-bg-white);
  border-bottom: 1rpx solid var(--color-divider);
}
.field-wrap .field {
  border-bottom: none;
}
.field-error {
  display: block;
  padding: 0 var(--space) 14rpx calc(var(--space) + 150rpx);
  font-size: var(--font-xs);
  color: var(--color-danger);
}

/* ---------------- 状态标签 ---------------- */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  font-size: var(--font-xs);
  border-radius: var(--radius-sm);
  line-height: 1.6;
}
.tag-primary {
  color: var(--color-primary-dark);
  background-color: var(--color-primary-light);
}
.tag-success {
  color: var(--color-success);
  background-color: rgba(31, 122, 69, 0.1);
}
.tag-warning {
  color: var(--color-warning);
  background-color: rgba(180, 83, 9, 0.12);
}
.tag-gray {
  color: var(--color-text-3);
  background-color: var(--color-divider);
}
.tag-danger {
  color: var(--color-danger);
  background-color: rgba(198, 40, 40, 0.1);
}

/* ---------------- 悬浮加号按钮（列表页右下角） ---------------- */
.fab {
  transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), opacity 120ms cubic-bezier(0.22, 1, 0.36, 1);
  position: fixed;
  right: 32rpx;
  /* 上移避开悬浮胶囊 tabBar */
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background-color: var(--color-primary-dark);
  color: #ffffff;
  font-size: 56rpx;
  line-height: 100rpx;
  text-align: center;
  box-shadow: var(--shadow-float);
  z-index: 20;
}

/* ---------------- 分隔 / 安全区 ---------------- */
.divider {
  height: 1rpx;
  background-color: var(--color-divider);
}
.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

/* ---------------- UI 优化方案 4.3：全局工具类（11-22） ---------------- */
/* 按压反馈：只动 transform / opacity，避免重排 */
.u-press {
  transition:
    transform var(--dur-fast) var(--ease-out),
    opacity var(--dur-fast) var(--ease-out);
}
.u-press--hover {
  /* 对齐 A 侧口径：opacity 压暗（scale 会引起文字重栅格化抖动，11-23 反馈） */
  opacity: 0.94;
}

/* 首屏入场：最多 6 个，延迟由页面内联 style 控制 */
@keyframes u-fade-up {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.u-enter {
  animation: u-fade-up var(--dur-slow) var(--ease-out) both;
}

/* 骨架 shimmer：替代各页面的 opacity pulse */
@keyframes sk-shimmer {
  from {
    background-position: 100% 0;
  }
  to {
    background-position: -100% 0;
  }
}
.sk-block {
  background: linear-gradient(90deg, #efe6d8 25%, #faf6ee 37%, #efe6d8 63%);
  background-size: 400% 100%;
  animation: sk-shimmer 1.4s ease infinite;
}

/* 骨架卡片通用结构：此前只有大厅页定义过，聊天列表/详情两页引用了却无样式（漏定义），现全局化 */
.sk-card {
  margin: 20rpx var(--space-page) 0;
  padding: 28rpx;
  background-color: var(--color-bg-white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}
.sk-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #efe6d8 25%, #faf6ee 37%, #efe6d8 63%);
  background-size: 400% 100%;
  animation: sk-shimmer 1.4s ease infinite;
}
.sk-line--lg {
  height: 32rpx;
  width: 55%;
}
.sk-line--md {
  height: 26rpx;
  width: 80%;
}
.sk-line--sm {
  height: 24rpx;
  width: 40%;
}
.sk-line + .sk-line {
  margin-top: 16rpx;
}

/* 分组标题：左侧短竖条，给详情/表单页建立节奏 */
.t-section {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.t-section::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
}
