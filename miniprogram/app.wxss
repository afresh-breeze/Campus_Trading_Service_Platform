/**
 * 全局样式（B 成员：公共层）
 * ------------------------------------------------------------------
 * 设计令牌 + 通用原子类。页面样式只允许引用这里的变量/类，
 * 不允许再出现魔法色值，方便后期统一改主题。
 */

page {
  /* 主色：按 A 手册 §12.2 明亮橙黄系（11-11 B 按 §12.2 建议值校准） */
  --color-primary: #FFA726;
  --color-primary-light: #FFF3E0;
  --color-primary-dark: #A94A00;

  /* 辅助色 */
  --color-accent: #FFD54F;
  /* 价格色：暖调深橙红，白底大字号可读（对比度约 4.3:1） */
  --color-price: #D84315;
  --color-success: #1F7A45;
  --color-warning: #B45309;
  --color-danger: #C62828;

  /* 中性色（暖色系） */
  --color-text: #2B2622;
  --color-text-2: #6B6259;
  --color-text-3: #9C9288;
  --color-text-4: #C4B8AA;
  --color-border: #F2E4D0;
  --color-divider: #F7EEE1;
  --color-bg: #FFF9F0;
  --color-bg-white: #FFFFFF;

  /* 圆角 / 阴影 / 间距 */
  --radius-sm: 8rpx;
  --radius: 16rpx;
  --radius-lg: 24rpx;
  --radius-full: 999rpx;
  --shadow-card: 0 4rpx 16rpx rgba(120, 80, 20, 0.08);
  --shadow-float: 0 8rpx 24rpx rgba(255, 167, 38, 0.32);
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;

  /* 字号层级 */
  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-base: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-2xl: 44rpx;

  background-color: var(--color-bg);
  color: var(--color-text);
  font-size: var(--font-base);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
button,
scroll-view {
  box-sizing: border-box;
}

/* ---------------- 布局 ---------------- */
.row {
  display: flex;
  align-items: center;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.col {
  display: flex;
  flex-direction: column;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------------- 容器 ---------------- */
.page {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: env(safe-area-inset-bottom);
}
.page-body {
  padding: var(--space);
}
.card {
  background-color: var(--color-bg-white);
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
  padding: var(--space);
}
.card + .card {
  margin-top: var(--space-sm);
}

/* ---------------- 文字 ---------------- */
.t-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}
.t-base {
  font-size: var(--font-base);
  color: var(--color-text);
}
.t-sub {
  font-size: var(--font-sm);
  color: var(--color-text-3);
}
.t-price {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-danger);
}
.t-price::before {
  content: '¥';
  font-size: var(--font-sm);
  margin-right: 2rpx;
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* ---------------- 按钮 ---------------- */
.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-full);
  font-size: var(--font-lg);
  font-weight: 500;
  background-color: var(--color-bg-white);
  color: var(--color-text);
  border: none;
}
.btn::after {
  border: none;
}
.btn-primary {
  background-color: var(--color-primary);
  color: #ffffff;
  box-shadow: var(--shadow-float);
}
.btn-primary[disabled] {
  background-color: #FFD9A0;
  color: #ffffff;
  box-shadow: none;
}
.btn-ghost {
  background-color: var(--color-bg-white);
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
}
.btn-danger {
  background-color: var(--color-danger);
  color: #ffffff;
}
.btn-block {
  width: 100%;
}
.btn-sm {
  height: 60rpx;
  line-height: 58rpx;
  font-size: var(--font-sm);
  padding: 0 24rpx;
}

/* ---------------- 表单 ---------------- */
.field {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 var(--space);
  background-color: var(--color-bg-white);
  border-bottom: 1rpx solid var(--color-divider);
}
.field-label {
  width: 150rpx;
  font-size: var(--font-base);
  color: var(--color-text);
}
.field-input {
  flex: 1;
  font-size: var(--font-base);
  color: var(--color-text);
}
.field-placeholder {
  color: var(--color-text-4);
}

/* ---------------- 状态标签 ---------------- */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  font-size: var(--font-xs);
  border-radius: var(--radius-sm);
  line-height: 1.6;
}
.tag-primary {
  color: var(--color-primary-dark);
  background-color: var(--color-primary-light);
}
.tag-success {
  color: var(--color-success);
  background-color: rgba(31, 122, 69, 0.1);
}
.tag-warning {
  color: var(--color-warning);
  background-color: rgba(180, 83, 9, 0.12);
}
.tag-gray {
  color: var(--color-text-3);
  background-color: var(--color-divider);
}
.tag-danger {
  color: var(--color-danger);
  background-color: rgba(198, 40, 40, 0.1);
}

/* ---------------- 悬浮加号按钮（列表页右下角） ---------------- */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  color: #ffffff;
  font-size: 56rpx;
  line-height: 100rpx;
  text-align: center;
  box-shadow: var(--shadow-float);
  z-index: 20;
}

/* ---------------- 分隔 / 安全区 ---------------- */
.divider {
  height: 1rpx;
  background-color: var(--color-divider);
}
.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}
